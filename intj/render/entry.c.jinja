static int intj_grid_object(PyObject *g, uint32_t *gx, uint32_t *gy, uint32_t *gz) {
  if (PyLong_CheckExact(g))
    return intj_grid_dim(g, gx);
  if (!PyTuple_CheckExact(g) && !PyList_CheckExact(g)) {
    PyErr_SetString(PyExc_TypeError,
                    "intj: grid must be an int, tuple or list of ints");
    return -1;
  }
{% if free_threaded %}
  /* Own a coherent snapshot if another thread can resize the list. */
  PyObject *snapshot = NULL;
  if (PyList_CheckExact(g)) {
    snapshot = PyList_AsTuple(g);
    if (!snapshot)
      return -1;
    g = snapshot;
  }
{% endif %}
  int is_tuple = PyTuple_CheckExact(g);
  Py_ssize_t n = is_tuple ? PyTuple_GET_SIZE(g) : PyList_GET_SIZE(g);
  if (n < 1 || n > 3) {
{% if free_threaded %}    Py_XDECREF(snapshot);
{% endif %}
    PyErr_SetString(PyExc_ValueError,
                    "intj: grid must have between 1 and 3 dimensions");
    return -1;
  }
  PyObject **items = is_tuple ? ((PyTupleObject *)g)->ob_item : ((PyListObject *)g)->ob_item;
  uint32_t *dims[3] = {gx, gy, gz};
  for (Py_ssize_t i = 0; i < n; i++) {
    if (intj_grid_dim(items[i], dims[i]) != 0) {
{% if free_threaded %}      Py_XDECREF(snapshot);
{% endif %}
      return -1;
    }
  }
{% if free_threaded %}  Py_XDECREF(snapshot);
{% endif %}
  return 0;
}
{% endif %}

static inline int intj_final_collect(intj_final *f, void *ctx) {
  intj_snapshot *s = (intj_snapshot *)ctx;
  (void)s;
{% if return_compiled %}
  if (intj_snapshot_add(s, f->k.compiled) != 0)
    return -1;
{% endif %}
{% if tuned_meta %}
  if (intj_snapshot_add(s, f->meta) != 0)
    return -1;
{% endif %}
  return 0;
}
{% for l in inner_levels %}
static inline int intj_rec_{{ l.n }}_collect(intj_rec_{{ l.n }} **p, void *ctx) {
  return intj_map_{{ l.child.n }}_each(&(*p)->child, {{ rec_collect(l.child) }}, ctx);
}
{% endfor %}
#define INTJ_V0_COLLECT {{ rec_collect(levels[0]) }}

static inline int intj_cache_traverse(intj_bound_launcher *bound, visitproc visit,
                                      void *arg) {
  intj_snapshot s = {NULL, 0, 0};
  INTJ_RDLOCK(&bound->lock);
  int failed = intj_cache_each(INTJ_BOUND_CACHE_OF(bound), INTJ_V0_COLLECT, &s);
  INTJ_RWUNLOCK(&bound->lock);
  return intj_snapshot_visit(&s, failed, visit, arg);
}

{% if not no_gpu %}
/* Two trailing scratch slots are mandatory on AMD; intj refuses kernels that
 * need non-empty scratch, so they are always null. */
static INTJ_ALWAYS_INLINE int32_t intj_launch(intj_state *st, const intj_kernel *k,
                                              uint32_t gx, uint32_t gy, uint32_t gz,
                                              uint64_t stream, uint64_t *vals, int np) {
  void *params[INTJ_NSLOTS + 2];
  for (int i = 0; i < np; i++)
    params[i] = &vals[i];
  uint64_t scratch[2] = {0, 0};
  params[np] = &scratch[0];
  params[np + 1] = &scratch[1];
  return st->launch(k->function, gx, gy, gz, k->block_dim, 1, 1, k->shared,
                    (void *)(uintptr_t)stream, params, NULL);
}

static PyObject *intj_launch_error(intj_state *st, int32_t status) {
  const char *message = NULL;
{% if error_style == 'return' %}
  if (st->error_string)
    message = st->error_string(status);
{% else %}
  if (st->error_string)
    st->error_string(status, &message);
{% endif %}
  PyErr_Format(PyExc_RuntimeError, "intj: {{ launch_symbol }} failed: %s",
               message ? message : "unknown error");
  return NULL;
}
{% endif %}

{% if not tuned %}
/* Cold path: Python assembles the final canonical ASTSource from the public
 * arguments and fixed annotations.  No lock is held while Python runs; another
 * thread may fill this key meanwhile, and the put rechecks. */
static int intj_fill(intj_state *st, intj_bound_launcher *bound,
                     const uint64_t *key, int np, int64_t device_ordinal,
                     PyObject *const *call_args) {
  (void)st;
  /* set by init_bound before the launcher was published; only tp_clear of an
   * unreachable launcher drops it */
  PyObject *cb = Py_NewRef(bound->compile_cb);
  PyObject *blob = PyBytes_FromStringAndSize((const char *)key, INTJ_KEY_BYTES);
  PyObject *nparams_obj = blob ? PyLong_FromLong(np) : NULL;
  PyObject *device_obj = nparams_obj ? PyLong_FromLongLong(device_ordinal) : NULL;
  if (!device_obj) {
    Py_XDECREF(blob);
    Py_XDECREF(nparams_obj);
    Py_DECREF(cb);
    return -1;
  }
  /* call_args: the dynamic values, then the public kernel arguments */
  PyObject *cb_args[3 + INTJ_NDYN + INTJ_NPARAMS];
  cb_args[0] = blob;
  cb_args[1] = nparams_obj;
  cb_args[2] = device_obj;
  for (int i = 0; i < INTJ_NDYN + INTJ_NPARAMS; i++)
    cb_args[3 + i] = call_args[i];
  PyObject *res = PyObject_Vectorcall(cb, cb_args, 3 + INTJ_NDYN + INTJ_NPARAMS, NULL);
  Py_DECREF(cb);
  Py_DECREF(blob);
  Py_DECREF(nparams_obj);
  Py_DECREF(device_obj);
  if (!res)
    return -1;
  unsigned long long function;
  unsigned int block_dim, shared, nparams;
{% if return_compiled %}
  PyObject *compiled;
  if (!PyArg_ParseTuple(res, "KIIIO", &function, &block_dim, &shared, &nparams,
                        &compiled)) {
{% else %}
  if (!PyArg_ParseTuple(res, "KIII", &function, &block_dim, &shared, &nparams)) {
{% endif %}
    Py_DECREF(res);
    return -1;
  }
  if (INTJ_UNLIKELY(block_dim == 0)) { /* marks an empty map slot */
    Py_DECREF(res);
    PyErr_SetString(PyExc_ValueError, "intj: compile callback returned block_dim 0");
    return -1;
  }
  intj_final fresh;
  memset(&fresh, 0, sizeof(fresh));
  fresh.k.function = (void *)(uintptr_t)function;
  fresh.k.block_dim = block_dim;
  fresh.k.shared = shared;
  fresh.k.nparams = nparams;
{% if return_compiled %}
  fresh.k.compiled = Py_NewRef(compiled);
{% endif %}
  Py_DECREF(res);
  int taken = 0, failed = 0;
  INTJ_WRLOCK(&bound->lock);
{% if nwords %}
  if (!intj_cache_lookup(INTJ_BOUND_CACHE_OF(bound), key)) {
    if (intj_cache_put(INTJ_BOUND_CACHE_OF(bound), key, &fresh))
      taken = 1;
    else
      failed = 1;
  }
{% else %}
  if (!bound->fixed_kernel) {
    intj_final *heap = (intj_final *)PyMem_RawMalloc(sizeof(intj_final));
    if (heap) {
      *heap = fresh;
      bound->fixed_kernel = heap;
      taken = 1;
    } else {
      failed = 1;
    }
  }
{% endif %}
  INTJ_RWUNLOCK(&bound->lock);
  if (!taken)
    intj_final_release(&fresh);
  if (failed) {
    PyErr_NoMemory();
    return -1;
  }
  return 0;
}
{% endif %}

{% if tuned %}
/* The final record with the read lock held, or NULL with it released:
 * *missed is then the first level without a record, or -1 if a heuristic
 * raised.  Non-final records never move, so each is read after its lookup's
 * unlock, and every heuristic runs unlocked.  `dep` receives every walked
 * level's dependent values, `comp` every level's computed keys. */
static INTJ_ALWAYS_INLINE intj_final *intj_walk(intj_state *st, intj_bound_launcher *bound,
                                                PyObject *const *kargs, const uint64_t *key,
                                                int64_t *comp, int64_t *dep, int *missed) {
  (void)kargs; (void)comp; (void)dep;
{% for l in levels %}
{% if l.n == 0 %}
  INTJ_RDLOCK(&bound->lock);
  {{ rec_type(l) }} *s0 = intj_cache_lookup(INTJ_BOUND_CACHE_OF(bound), key);
{% else %}
  if (intj_tuned_level_{{ l.n }}(st, kargs, dep, comp) != 0) {
    *missed = -1;
    return NULL;
  }
  INTJ_RDLOCK(&bound->lock);
  {{ rec_type(l) }} *s{{ l.n }} =
      intj_map_{{ l.n }}_lookup(&rec_{{ l.parent }}->child, (const uint64_t *)(comp + {{ l.comp_at }}));
{% endif %}
  if (INTJ_UNLIKELY(!s{{ l.n }})) {
    INTJ_RWUNLOCK(&bound->lock);
    *missed = {{ l.n }};
    return NULL;
  }
{% if not l.final %}
  intj_rec_{{ l.n }} *rec_{{ l.n }} = *s{{ l.n }};
  INTJ_RWUNLOCK(&bound->lock);
{% if l.deps %}
  memcpy(dep + {{ l.dep_at }}, rec_{{ l.n }}->dep, sizeof(rec_{{ l.n }}->dep));
{% endif %}
{% else %}
{% if l.deps %}
  memcpy(dep + {{ l.dep_at }}, s{{ l.n }}->dep, sizeof(s{{ l.n }}->dep));
{% endif %}
  return s{{ l.n }};
{% endif %}
{% endfor %}
}

static const char *const intj_computed_names[{{ computed_names_len }}] = {
{% for name in tuning.computed_names %}    "{{ name }}",
{% endfor %}    NULL};

/* A dependent value from the callback: an exact int or a bool. */
static int intj_dep_value(PyObject *o, int64_t *value, int64_t *is_bool) {
  if (o == Py_True || o == Py_False) {
    *value = o == Py_True;
    *is_bool = 1;
    return 0;
  }
  *is_bool = 0;
  if (PyLong_CheckExact(o) && intj_as_i64(o, value) == 0)
    return 0;
  PyErr_SetString(PyExc_TypeError, "intj: tuned value read by C must be an int64 or bool");
  return -1;
}

/* Miss: Python runs the private chain, which tunes and launches.  The record
 * is only filled here, never launched a second time. */
static PyObject *intj_tuned_fill(intj_state *st, intj_bound_launcher *bound,
                                 const uint64_t *key,
                                 int np, int64_t device_ordinal, uint64_t stream,
                                 uint32_t gx, uint32_t gy, uint32_t gz,
                                 PyObject *const *args, int64_t *comp, int64_t *dep) {
{% if grid_cpp_source %}
  PyObject *controls = PyTuple_New({{ grid_count }});
  if (!controls)
    return NULL;
  for (int i = 0; i < {{ grid_count }}; i++)
    PyTuple_SET_ITEM(controls, i, Py_NewRef(args[i]));
{% elif grid_py_mode %}
  PyObject *controls = Py_NewRef(Py_None);
{% else %}
  PyObject *controls = Py_BuildValue("(III)", gx, gy, gz);
  if (!controls)
    return NULL;
{% endif %}
  (void)gx; (void)gy; (void)gz;
  PyObject *blob = PyBytes_FromStringAndSize((const char *)key, INTJ_KEY_BYTES);
  PyObject *nparams_obj = blob ? PyLong_FromLong(np) : NULL;
  PyObject *device_obj = nparams_obj ? PyLong_FromLongLong(device_ordinal) : NULL;
  PyObject *stream_obj = device_obj ? PyLong_FromUnsignedLongLong(stream) : NULL;
  if (!stream_obj) {
    Py_XDECREF(blob); Py_XDECREF(nparams_obj); Py_XDECREF(device_obj);
    Py_DECREF(controls);
    return NULL;
  }
  /* after the controls: the dynamic values, then the public kernel arguments */
  PyObject *cb_args[5 + INTJ_NDYN + INTJ_NPARAMS];
  cb_args[0] = blob; cb_args[1] = nparams_obj; cb_args[2] = device_obj;
  cb_args[3] = stream_obj; cb_args[4] = controls;
  for (int i = 0; i < INTJ_NDYN + INTJ_NPARAMS; i++)
    cb_args[5 + i] = args[{{ grid_count }} + i];
  PyObject *cb = Py_NewRef(bound->compile_cb);
  PyObject *res = PyObject_Vectorcall(cb, cb_args, 5 + INTJ_NDYN + INTJ_NPARAMS, NULL);
  Py_DECREF(cb); Py_DECREF(blob); Py_DECREF(nparams_obj);
  Py_DECREF(device_obj); Py_DECREF(stream_obj); Py_DECREF(controls);
  if (!res)
    return NULL;
  unsigned long long function;
  unsigned int block_dim, shared, nparams;
  PyObject *compiled, *deps, *computed, *meta;
  if (!PyArg_ParseTuple(res, "KIIIOOOO", &function, &block_dim, &shared, &nparams,
                        &compiled, &deps, &computed, &meta)) {
    Py_DECREF(res);
    return NULL;
  }
  if (INTJ_UNLIKELY(block_dim == 0)) { /* marks an empty map slot */
    Py_DECREF(res);
    PyErr_SetString(PyExc_ValueError, "intj: tuned callback returned block_dim 0");
    return NULL;
  }
  intj_final fresh;
  memset(&fresh, 0, sizeof(fresh));
  if (!PyTuple_CheckExact(deps) || PyTuple_GET_SIZE(deps) != {{ ndeps }}) {
    Py_DECREF(res);
    PyErr_SetString(PyExc_RuntimeError, "intj: tuned callback returned the wrong deps; this is an intj bug");
    return NULL;
  }
{% if grid_py_mode %}
  if (!PyTuple_CheckExact(meta) || PyTuple_GET_SIZE(meta) != {{ nmeta }}) {
    Py_DECREF(res);
    PyErr_SetString(PyExc_RuntimeError, "intj: tuned callback returned the wrong meta; this is an intj bug");
    return NULL;
  }
{% endif %}
  /* Every level's dependent values, in the slots the walk would fill. */
  for (int i = 0; i < {{ ndeps }}; i++)
    if (intj_dep_value(PyTuple_GET_ITEM(deps, i), &dep[2 * i], &dep[2 * i + 1]) != 0) {
      Py_DECREF(res);
      return NULL;
    }
{% if levels[-1].deps %}
  memcpy(fresh.dep, dep + {{ levels[-1].dep_at }}, sizeof(fresh.dep));
{% endif %}
  /* Keys past level 0, from the values this run recorded; no lock is held. */
{% for l in later_levels %}
  if (intj_tuned_level_{{ l.n }}(st, args + {{ grid_count }} + INTJ_NDYN, dep, comp) != 0) {
    Py_DECREF(res);
    return NULL;
  }
{% endfor %}
  /* The lowering must agree with Triton's own evaluation, kind included. */
  if (!PyTuple_CheckExact(computed) || PyTuple_GET_SIZE(computed) != {{ ncomp }}) {
    Py_DECREF(res);
    PyErr_SetString(PyExc_RuntimeError, "intj: tuned callback returned the wrong computed; this is an intj bug");
    return NULL;
  }
  for (int i = 0; i < {{ ncomp }}; i++) {
    PyObject *item = PyTuple_GET_ITEM(computed, i);
    int64_t value = 0;
    int same = item == Py_True || item == Py_False
                   ? comp[2 * i + 1] == 1 && comp[2 * i] == (item == Py_True)
                   : comp[2 * i + 1] == 0 && PyLong_CheckExact(item) &&
                         intj_as_i64(item, &value) == 0 && value == comp[2 * i];
    if (!same) {
      PyErr_Format(PyExc_RuntimeError,
                   "intj: heuristic '%s' lowered to %lld but Triton computed %R; this is an intj bug",
                   intj_computed_names[i], (long long)comp[2 * i], item);
      Py_DECREF(res);
      return NULL;
    }
  }
  fresh.k.function = (void *)(uintptr_t)function;
  fresh.k.block_dim = block_dim;
  fresh.k.shared = shared;
  fresh.k.nparams = nparams;
{% if return_compiled %}
  fresh.k.compiled = Py_NewRef(compiled);
{% endif %}
{% if grid_py_mode %}
  fresh.meta = Py_NewRef(meta);
{% endif %}
  Py_DECREF(res);
  int taken = 0, failed = 0, mismatch = 0;
  PyObject *out = NULL;
  /* Every missing level is filled here; a present one must agree. */
  intj_cache *cache = INTJ_BOUND_CACHE_OF(bound);
  INTJ_WRLOCK(&bound->lock);
{% if nlevels == 1 %}
  intj_final *stored = intj_cache_lookup(cache, key);
  if (stored) {
    mismatch = memcmp(stored->dep, fresh.dep, sizeof(fresh.dep)) != 0;
  } else {
    stored = intj_cache_put(cache, key, &fresh);
    taken = stored != NULL;
    failed = stored == NULL;
  }
{% else %}
  {{ rec_type(levels[0]) }} *s0 = intj_cache_lookup(cache, key);
  if (!s0) {
    intj_rec_0 *r = (intj_rec_0 *)PyMem_RawCalloc(1, sizeof(intj_rec_0));
    if (r && intj_map_1_init(&r->child) == 0) {
{% if levels[0].deps %}
      memcpy(r->dep, dep + {{ levels[0].dep_at }}, sizeof(r->dep));
{% endif %}
      s0 = intj_cache_put(cache, key, &r);
      if (!s0) {
        intj_map_1_free(&r->child, {{ rec_release(levels[1]) }});
        PyMem_RawFree(r);
      }
    } else {
      PyMem_RawFree(r);
    }
    failed = !s0;
{% if levels[0].deps %}
  } else {
    mismatch |= memcmp((*s0)->dep, dep + {{ levels[0].dep_at }}, sizeof((*s0)->dep)) != 0;
{% endif %}
  }
{% for l in later_levels %}
  {{ rec_type(l) }} *s{{ l.n }} = NULL;
  if (!failed && !mismatch) { /* a disagreeing parent gets no children */
    const uint64_t *k{{ l.n }} = (const uint64_t *)(comp + {{ l.comp_at }});
    s{{ l.n }} = intj_map_{{ l.n }}_lookup(&(*s{{ l.parent }})->child, k{{ l.n }});
{% if l.final %}
    if (!s{{ l.n }}) {
      s{{ l.n }} = intj_map_{{ l.n }}_put(&(*s{{ l.parent }})->child, k{{ l.n }}, &fresh);
      taken = s{{ l.n }} != NULL;
      failed = !s{{ l.n }};
    } else {
      mismatch |= memcmp(s{{ l.n }}->dep, fresh.dep, sizeof(fresh.dep)) != 0;
    }
{% else %}
    if (!s{{ l.n }}) {
      intj_rec_{{ l.n }} *r = (intj_rec_{{ l.n }} *)PyMem_RawCalloc(1, sizeof(intj_rec_{{ l.n }}));
      if (r && intj_map_{{ l.child.n }}_init(&r->child) == 0) {
{% if l.deps %}
        memcpy(r->dep, dep + {{ l.dep_at }}, sizeof(r->dep));
{% endif %}
        s{{ l.n }} = intj_map_{{ l.n }}_put(&(*s{{ l.parent }})->child, k{{ l.n }}, &r);
        if (!s{{ l.n }}) {
          intj_map_{{ l.child.n }}_free(&r->child, {{ rec_release(l.child) }});
          PyMem_RawFree(r);
        }
      } else {
        PyMem_RawFree(r);
      }
      failed = !s{{ l.n }};
{% if l.deps %}
    } else {
      mismatch |= memcmp((*s{{ l.n }})->dep, dep + {{ l.dep_at }}, sizeof((*s{{ l.n }})->dep)) != 0;
{% endif %}
    }
{% endif %}
  }
{% endfor %}
  intj_final *stored = s{{ levels[-1].n }};
{% endif %}
{% if return_compiled %}
  if (stored && !mismatch)
    out = Py_NewRef(stored->k.compiled);
{% endif %}
  (void)stored;
  INTJ_RWUNLOCK(&bound->lock);
  if (!taken)
    intj_final_release(&fresh);
  if (failed)
    return PyErr_NoMemory();
  if (mismatch) {
    PyErr_SetString(PyExc_RuntimeError,
                    "intj: two tuning runs recorded different values for one key; this is an intj bug");
    return NULL;
  }
{% if return_compiled %}
  return out;
{% else %}
  (void)out;
  Py_RETURN_NONE;
{% endif %}
}

{% if grid_py_mode %}
static PyObject *intj_tuned_grid_py_launch(intj_state *st, intj_bound_launcher *bound,
                                           const intj_final *copy, uint64_t stream,
                                           PyObject *const *args, uint64_t *vals, int np) {
  PyObject *meta = PyDict_New();
  if (!meta)
    return NULL;
{% for p in params %}
{% if p.call_index is not none %}
  if (PyDict_SetItemString(meta, intj_param_names[{{ p.index }}], args[{{ p.call_index }}]) != 0) goto fail;
{% elif p.annotation.tuned %}
  if (PyDict_SetItemString(meta, intj_param_names[{{ p.index }}],
                           PyTuple_GET_ITEM(copy->meta, {{ p.meta_slot }})) != 0) goto fail;
{% else %}
  if (PyDict_SetItemString(meta, intj_param_names[{{ p.index }}],
                           PyTuple_GET_ITEM(bound->grid_hidden, {{ p.hidden_slot }})) != 0) goto fail;
{% endif %}
{% endfor %}
  {
    PyObject *grid_args[1] = {meta};
    PyObject *g = PyObject_Vectorcall(bound->grid_py, grid_args, 1, NULL);
    Py_DECREF(meta);
    meta = NULL;
    if (!g)
      return NULL;
    uint32_t gx = 1, gy = 1, gz = 1;
    int status = intj_grid_object(g, &gx, &gy, &gz);
    Py_DECREF(g);
    if (status != 0)
      return NULL;
    if (INTJ_UNLIKELY((uint32_t)np != copy->k.nparams)) {
      PyErr_SetString(PyExc_RuntimeError, "intj: kernel argument count changed; this is an intj bug");
      return NULL;
    }
    if (gx && gy && gz) {
      int32_t rc = intj_launch(st, &copy->k, gx, gy, gz, stream, vals, np);
      if (rc)
        return intj_launch_error(st, rc);
    }
  }
{% if return_compiled %}
  return Py_NewRef(copy->k.compiled);
{% else %}
  Py_RETURN_NONE;
{% endif %}
fail:
  Py_XDECREF(meta);
  return NULL;
}
{% endif %}
{% endif %}

