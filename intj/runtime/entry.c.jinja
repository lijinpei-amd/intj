/* Parse one grid dimension. Returns -1 on error. */
static int intj_grid_dim(PyObject *o, uint32_t *out) {
  int64_t v;
  if (INTJ_UNLIKELY(!PyLong_CheckExact(o) || intj_as_i64(o, &v) != 0 || v < 0 ||
                    v > 4294967295LL)) {
    PyErr_SetString(PyExc_ValueError,
                    "intj: grid dimensions must be ints in [0, 2**32)");
    return -1;
  }
  *out = (uint32_t)v;
  return 0;
}

static INTJ_ALWAYS_INLINE int intj_parse_call(intj_state *st,
                                              PyObject *const *args, Py_ssize_t nargs,
                                              int64_t *device, uint64_t *stream) {
  if (INTJ_UNLIKELY(!st->abi.ready)) {
    PyErr_SetString(PyExc_RuntimeError,
                    "intj: set_torch_version has not been called");
    return -1;
  }
  if (INTJ_UNLIKELY(nargs != 3 + INTJ_NPARAMS)) {
    PyErr_Format(PyExc_TypeError,
                 "intj: %s takes exactly %d arguments (device, stream, grid and "
                 "%d kernel arguments), got %zd",
                 "{{ kernel_repr }}", 3 + INTJ_NPARAMS, INTJ_NPARAMS, nargs);
    return -1;
  }

  /* device / stream */
  /* One byte of the key holds this, so the upper bound is load-bearing: device
   * 256 would alias device 0 and launch on the wrong context.  It is checked
   * here, with the parse, rather than beside the key build -- a zero-volume
   * grid returns below, before any key exists. */
  if (INTJ_UNLIKELY(!PyLong_CheckExact(args[0]) ||
                    intj_as_i64(args[0], device) != 0 || *device < 0 ||
                    *device > 255)) {
    PyErr_SetString(PyExc_TypeError, "intj: device must be an int in [0, 256)");
    return -1;
  }
  {
    int64_t s;
    if (INTJ_UNLIKELY(!PyLong_CheckExact(args[1]) ||
                      intj_as_i64(args[1], &s) != 0 || s < 0)) {
      PyErr_SetString(PyExc_TypeError,
                      "intj: stream must be a non-negative int handle");
      return -1;
    }
    *stream = (uint64_t)s;
  }
  return 0;
}

/* args starts at grid; the remaining entries are the public kernel arguments. */
static PyObject *intj_call(intj_state *st, intj_cache *cache,
                           intj_kernel **fixed_kernel, int fixed_device,
                           int64_t device_ordinal, uint64_t stream,
                           PyObject *const *args, Py_ssize_t nargs,
                           intj_bound_launcher *bound) {
  (void)fixed_kernel;
  (void)fixed_device;
  (void)nargs;
  /* grid */
  uint32_t gx = 1, gy = 1, gz = 1;
  {
    PyObject *g = args[0];
    if (PyLong_CheckExact(g)) {
      if (intj_grid_dim(g, &gx) != 0)
        return NULL;
    } else if (PyTuple_CheckExact(g) || PyList_CheckExact(g)) {
      PyObject **items;
      Py_ssize_t n;
      if (PyTuple_CheckExact(g)) {
        n = PyTuple_GET_SIZE(g);
        items = &PyTuple_GET_ITEM(g, 0);
      } else {
        n = PyList_GET_SIZE(g);
        items = &PyList_GET_ITEM(g, 0);
      }
      if (n < 1 || n > 3) {
        PyErr_SetString(PyExc_ValueError,
                        "intj: grid must have between 1 and 3 dimensions");
        return NULL;
      }
      uint32_t *dims[3] = {&gx, &gy, &gz};
      for (Py_ssize_t i = 0; i < n; i++)
        if (intj_grid_dim(items[i], dims[i]) != 0)
          return NULL;
    } else {
      PyErr_SetString(PyExc_TypeError,
                      "intj: grid must be an int, tuple or list of ints");
      return NULL;
    }
  }
  if (INTJ_UNLIKELY((uint64_t)gx * (uint64_t)gy * (uint64_t)gz == 0))
    Py_RETURN_NONE;

  /* Key fields have render-time offsets; zero initialization also clears padding. */
  uint64_t key[INTJ_NWORDS] = {0};
  uint64_t vals[INTJ_NSLOTS];
  int np = 0;
  if (intj_pack(st, args + 1, key, vals, &np, bound) != 0)
    return NULL;
{% if device_offset is not none %}  ((uint8_t *)key)[{{ device_offset }}] = (uint8_t)device_ordinal;
{% endif %}

  uint64_t hash = intj_hash(key);
  intj_kernel *kernel = intj_cache_get(cache, key, hash);
  if (INTJ_UNLIKELY(!kernel)) {
    /* Cold path: Python assembles the final canonical ASTSource from the
     * public arguments and fixed annotations, without owning bound values. */
    if (!st->compile_cb) {
      PyErr_SetString(PyExc_RuntimeError, "intj: compile callback is not set");
      return NULL;
    }
    PyObject *blob = PyBytes_FromStringAndSize((const char *)key, INTJ_KEY_BYTES);
    if (!blob)
      return NULL;
    PyObject *nparams_obj = PyLong_FromLong(np);
    if (!nparams_obj) {
      Py_DECREF(blob);
      return NULL;
    }
    PyObject *device_obj = PyLong_FromLongLong(device_ordinal);
    if (!device_obj) {
      Py_DECREF(blob);
      Py_DECREF(nparams_obj);
      return NULL;
    }
    PyObject *cb_args[3 + INTJ_NPARAMS];
    cb_args[0] = blob;
    cb_args[1] = nparams_obj;
    cb_args[2] = device_obj;
    for (int i = 0; i < INTJ_NPARAMS; i++)
      cb_args[3 + i] = args[1 + i];
    PyObject *cb = Py_NewRef(st->compile_cb);
    PyObject *res = PyObject_Vectorcall(cb, cb_args, 3 + INTJ_NPARAMS, NULL);
    Py_DECREF(cb);
    Py_DECREF(blob);
    Py_DECREF(nparams_obj);
    Py_DECREF(device_obj);
    if (!res)
      return NULL;
    unsigned long long function;
    unsigned int block_dim, shared, nparams;
    if (!PyArg_ParseTuple(res, "KIII", &function, &block_dim, &shared,
                          &nparams)) {
      Py_DECREF(res);
      return NULL;
    }
    Py_DECREF(res);
    /* The callback ran python, so another thread may have filled this key. */
    kernel = intj_cache_get(cache, key, hash);
    if (!kernel) {
      kernel = (intj_kernel *)PyMem_RawMalloc(sizeof(intj_kernel));
      if (!kernel)
        return PyErr_NoMemory();
      kernel->function = (void *)(uintptr_t)function;
      kernel->block_dim = block_dim;
      kernel->shared = shared;
      kernel->nparams = nparams;
      if (intj_cache_put(cache, key, hash, kernel) != 0) {
        PyMem_RawFree(kernel);
        return PyErr_NoMemory();
      }
    }
  }

  if (INTJ_UNLIKELY((uint32_t)np != kernel->nparams)) {
    PyErr_Format(PyExc_RuntimeError,
                 "intj: kernel argument count changed for an identical spec "
                 "key (%d vs %u); this is an intj bug",
                 np, kernel->nparams);
    return NULL;
  }

{% if not no_gpu %}
  /* Launch. Two trailing scratch slots are mandatory on AMD; intj refuses
   * kernels that need non-empty scratch, so they are always null. */
  void *params[INTJ_NSLOTS + 2];
  for (int i = 0; i < np; i++)
    params[i] = &vals[i];
  uint64_t scratch[2] = {0, 0};
  params[np] = &scratch[0];
  params[np + 1] = &scratch[1];

  int32_t status =
      st->launch(kernel->function, gx, gy, gz, kernel->block_dim, 1, 1,
                 kernel->shared, (void *)(uintptr_t)stream, params, NULL);
  if (INTJ_UNLIKELY(status != 0)) {
    const char *message = NULL;
{% if error_style == 'return' %}
    if (st->error_string)
      message = st->error_string(status);
{% else %}
    if (st->error_string)
      st->error_string(status, &message);
{% endif %}
    PyErr_Format(PyExc_RuntimeError, "intj: {{ launch_symbol }} failed: %s",
                 message ? message : "unknown error");
    return NULL;
  }
{% endif %}
  Py_RETURN_NONE;
}

static PyObject *entry(PyObject *self, PyObject *const *args, Py_ssize_t nargs) {
  intj_state *st = (intj_state *)PyModule_GetState(self);
  int64_t device;
  uint64_t stream;
  if (intj_parse_call(st, args, nargs, &device, &stream) != 0)
    return NULL;
  return intj_call(st, &st->cache, NULL, 0, device, stream, args + 2, nargs - 2, NULL);
}

static PyObject *intj_bound_vectorcall(PyObject *self, PyObject *const *args,
                                       size_t nargsf, PyObject *kwnames) {
  intj_bound_launcher *bound = (intj_bound_launcher *)self;
  if (INTJ_UNLIKELY(kwnames && PyTuple_GET_SIZE(kwnames))) {
    PyErr_SetString(PyExc_TypeError, "intj: bound launchers do not accept keyword arguments");
    return NULL;
  }
  if (INTJ_UNLIKELY(!bound->module)) {
    PyErr_SetString(PyExc_RuntimeError, "intj: bound launcher has been cleared");
    return NULL;
  }
  intj_state *st = (intj_state *)PyModule_GetState(bound->module);
  Py_ssize_t nargs = PyVectorcall_NARGS(nargsf);
  int64_t device;
  uint64_t stream;
  if (intj_parse_call(st, args, nargs, &device, &stream) != 0)
    return NULL;
  if (Py_EnterRecursiveCall(" while calling an intj launcher"))
    return NULL;
  PyObject *result = NULL;
#ifdef __cplusplus
  try {
#endif
    result = intj_call(st, &st->cache, NULL, 0, device, stream,
                        args + 2, nargs - 2, bound);
#ifdef __cplusplus
  } catch (const std::bad_alloc &) {
    PyErr_NoMemory();
  } catch (const std::exception &error) {
    PyErr_SetString(PyExc_RuntimeError, error.what());
  } catch (...) {
    PyErr_SetString(PyExc_RuntimeError, "intj: C++ exception in bound launcher");
  }
#endif
  Py_LeaveRecursiveCall();
  return result;
}

static int intj_bound_traverse(PyObject *self, visitproc visit, void *arg) {
  intj_bound_launcher *bound = (intj_bound_launcher *)self;
  Py_VISIT(Py_TYPE(self));
  Py_VISIT(bound->module);
  Py_VISIT(bound->signature);
  for (int i = 0; i < INTJ_NBOUND; i++)
    Py_VISIT(bound->owners[i]);
  return 0;
}

static int intj_bound_clear(PyObject *self) {
  intj_bound_launcher *bound = (intj_bound_launcher *)self;
  /* Mark closed before dropping owners whose finalizers can reenter Python. */
  Py_CLEAR(bound->module);
  Py_CLEAR(bound->signature);
  for (int i = 0; i < INTJ_NBOUND; i++) {
    Py_CLEAR(bound->owners[i]);
#if defined(INTJ_ACCESS_CXX)
    delete bound->tensors[i];
    bound->tensors[i] = NULL;
#endif
  }
  if (bound->cache_ready) {
    intj_cache_free(&bound->cache);
    bound->cache_ready = 0;
  }
  PyMem_RawFree(bound->fixed_kernel);
  bound->fixed_kernel = NULL;
  return 0;
}

static void intj_bound_dealloc(PyObject *self) {
  PyTypeObject *type = Py_TYPE(self);
  PyObject_GC_UnTrack(self);
  intj_bound_clear(self);
  type->tp_free(self);
  Py_DECREF(type);
}

static PyObject *intj_bound_signature(PyObject *self, void *closure) {
  (void)closure;
  PyObject *value = ((intj_bound_launcher *)self)->signature;
  return Py_NewRef(value ? value : Py_None);
}

static PyObject *intj_bound_module(PyObject *self, void *closure) {
  (void)closure;
  PyObject *value = ((intj_bound_launcher *)self)->module;
  return Py_NewRef(value ? value : Py_None);
}

static PyGetSetDef intj_bound_getset[] = {
    {(char *)"__signature__", intj_bound_signature, NULL, NULL, NULL},
    {(char *)"__self__", intj_bound_module, NULL, NULL, NULL},
    {NULL, NULL, NULL, NULL, NULL}};

static PyType_Slot intj_bound_slots[] = {
    {Py_tp_call, (void *)PyVectorcall_Call},
    {Py_tp_traverse, (void *)intj_bound_traverse},
    {Py_tp_clear, (void *)intj_bound_clear},
    {Py_tp_dealloc, (void *)intj_bound_dealloc},
    {Py_tp_getset, (void *)intj_bound_getset},
    {0, NULL}};

static PyType_Spec intj_bound_spec = {
    "{{ module_name }}.BoundLauncher", sizeof(intj_bound_launcher), 0,
    Py_TPFLAGS_DEFAULT | Py_TPFLAGS_HAVE_GC | Py_TPFLAGS_HAVE_VECTORCALL |
        Py_TPFLAGS_IMMUTABLETYPE | Py_TPFLAGS_DISALLOW_INSTANTIATION,
    intj_bound_slots};

static PyObject *make_bound(PyObject *self, PyObject *const *args, Py_ssize_t nargs) {
  intj_state *st = (intj_state *)PyModule_GetState(self);
  if (nargs != 1 + INTJ_NBOUND) {
    PyErr_Format(PyExc_TypeError, "intj: make_bound takes %d arguments, got %zd",
                 1 + INTJ_NBOUND, nargs);
    return NULL;
  }
  if (!st->abi.ready) {
    PyErr_SetString(PyExc_RuntimeError, "intj: set_torch_version has not been called");
    return NULL;
  }
  intj_bound_launcher *bound = NULL;
#ifdef __cplusplus
  try {
#endif
    bound = (intj_bound_launcher *)st->bound_type->tp_alloc(st->bound_type, 0);
    if (!bound)
      return NULL;
    bound->vectorcall = intj_bound_vectorcall;
    bound->module = Py_NewRef(self);
    bound->signature = Py_NewRef(args[0]);
{% for p in bound_params %}
{% set i = p.index %}
{% set a = p.annotation %}
{% if a.bind_value == 'tensor' %}
    if (intj_bind_tensor(bound, {{ loop.index0 }}, args[{{ loop.index }}],
                          st->tensor_type, st->param_type, intj_param_names[{{ i }}]) != 0)
      goto fail;
{% else %}
    intj_decoded decoded_{{ i }};
    if (intj_decode_pointer(&st->abi, st->tensor_type, st->param_type,
                             args[{{ loop.index }}], intj_param_names[{{ i }}], &decoded_{{ i }}) != 0)
      goto fail;
{% set checks = [] %}
{% if verify_annotation %}
{% set matches = pointer_types | selectattr('0', 'equalto', a.types[0]) | list %}
{% set _ = checks.append(('(decoded_' ~ i ~ '.kind != INTJ_VALUE_TENSOR || ' ~ ('intj_infer_type(&decoded_' ~ i ~ ') == ' ~ type_code(a.types[0]) if matches else '0') ~ ')', 'type', 'TypeError')) %}
{% if a.aligned_16 == 'assume' %}
{% set _ = checks.append(('(decoded_' ~ i ~ '.bits & 15u) == 0', 'aligned_16', 'ValueError')) %}
{% endif %}
{% endif %}
{% if checks %}
    int valid_{{ i }} = {% for expression, message, error in checks %}({{ expression }}){{ ' && ' if not loop.last }}{% endfor %};
    if (INTJ_UNLIKELY(!valid_{{ i }})) {
{% for expression, message, error in checks %}
      if (!({{ expression }})) {
        PyErr_Format(PyExc_{{ error }}, "intj: argument '%s' violates {{ message }}",
                     intj_param_names[{{ i }}]);
        goto fail;
      }
{% endfor %}
    }
    INTJ_ASSUME(valid_{{ i }});
{% endif %}
    bound->pointer_bits[{{ loop.index0 }}] = decoded_{{ i }}.bits;
    if (!PyLong_CheckExact(args[{{ loop.index }}]))
      bound->owners[{{ loop.index0 }}] = Py_NewRef(args[{{ loop.index }}]);
{% endif %}
{% endfor %}
    return (PyObject *)bound;
#ifdef __cplusplus
  } catch (const std::bad_alloc &) {
    PyErr_NoMemory();
  } catch (const std::exception &error) {
    PyErr_SetString(PyExc_RuntimeError, error.what());
  } catch (...) {
    PyErr_SetString(PyExc_RuntimeError, "intj: C++ exception while binding arguments");
  }
#endif
fail:
  Py_XDECREF((PyObject *)bound);
  return NULL;
}

/* Debug/test entry point: the spec key intj would compute for these arguments,
 * without compiling or launching anything.  Used by the differential tests to
 * assert that intj's key is never coarser than triton's specialization. */
static PyObject *spec_key(PyObject *self, PyObject *const *args,
                          Py_ssize_t nargs) {
  intj_state *st = (intj_state *)PyModule_GetState(self);
  if (!st->abi.ready) {
    PyErr_SetString(PyExc_RuntimeError,
                    "intj: set_torch_version has not been called");
    return NULL;
  }
  if (nargs != INTJ_NPARAMS) {
    PyErr_Format(PyExc_TypeError, "intj: spec_key takes %d arguments, got %zd",
                 INTJ_NPARAMS, nargs);
    return NULL;
  }
  uint64_t key[INTJ_NWORDS] = {0};
  uint64_t vals[INTJ_NSLOTS];
  int np = 0;
  uint32_t device = 0; /* no launch, so no device to key on */
  if (intj_pack(st, args, key, vals, &np, NULL) != 0)
    return NULL;
{% if device_offset is not none %}  ((uint8_t *)key)[{{ device_offset }}] = (uint8_t)device;
{% endif %}
  return Py_BuildValue("(y#i)", (const char *)key, (Py_ssize_t)INTJ_KEY_BYTES, np);
}

static PyObject *set_compile_callback(PyObject *self, PyObject *cb) {
  intj_state *st = (intj_state *)PyModule_GetState(self);
  Py_INCREF(cb);
  Py_XSETREF(st->compile_cb, cb);
  Py_RETURN_NONE;
}

/* set_torch_version((major, minor), layout, dtype_index) -- install the torch ABI.
 *
 * Deliberately not baked into the binary: the offsets come from the torch that
 * is running now, so there is no window in which a cached .so built against one
 * torch is loaded against another.  `layout` is None in the cpython mode.
 *
 * Nothing is written into `st->abi` until every argument has been checked.  The
 * method is reachable from python on a module that is already configured and
 * whose kernel cache already holds entries, so a call that failed halfway used
 * to leave it live with a half-installed table -- one key byte for every dtype,
 * which is a silently wrong kernel rather than an error.
 */
static PyObject *set_torch_version(PyObject *self, PyObject *const *args,
                                   Py_ssize_t nargs) {
  intj_state *st = (intj_state *)PyModule_GetState(self);
  PyObject *layout;
  if (nargs != 3) {
    PyErr_SetString(
        PyExc_TypeError,
        "intj: set_torch_version takes (version, layout, dtype_index)");
    return NULL;
  }
  layout = args[1];

  /* Every mode reads this table -- it is what the key encodes, not how a
   * pointer is computed -- so it is validated here rather than in a branch. */
  const uint8_t *index;
  {
    Py_ssize_t n = PyBytes_Size(args[2]);
    if (n < 0)
      return NULL;
    if (n != INTJ_NDTYPES) {
      PyErr_Format(PyExc_ValueError,
                   "intj: dtype index table must be %d bytes, got %zd",
                   INTJ_NDTYPES, n);
      return NULL;
    }
    index = (const uint8_t *)PyBytes_AS_STRING(args[2]);
    /* The key gives the index five bits.  A larger one would not overflow into
     * the next parameter's byte -- it would shift the pointer code past 127 and
     * alias a scalar tag, so a float32 pointer could key as a 16-divisible
     * int64.  0xFF is the "triton does not take this dtype" sentinel. */
    for (int i = 0; i < INTJ_NDTYPES; i++)
      if (index[i] >= 32u && index[i] != 0xFFu) {
        PyErr_Format(PyExc_ValueError,
                     "intj: dtype index table[%d] is %u; the spec key has five "
                     "bits for it",
                     i, (unsigned)index[i]);
        return NULL;
      }
  }

{% if torch_access == 'shim' %}
  unsigned int off[7];
  PyObject *sizes;
  if (!PyTuple_Check(layout)) {
    PyErr_Format(PyExc_ValueError,
                 "intj: this module was built with the shim access mode and needs "
                 "a tensor layout, got %s",
                 Py_TYPE(layout)->tp_name);
    return NULL;
  }
  if (!PyArg_ParseTuple(layout, "IIIIIIIO", &off[0], &off[1], &off[2], &off[3],
                        &off[4], &off[5], &off[6], &sizes))
    return NULL;
  Py_ssize_t n = PyBytes_Size(sizes);
  if (n < 0)
    return NULL;
  if (n != INTJ_NDTYPES) {
    PyErr_Format(PyExc_ValueError, "intj: itemsize table must be %d bytes, got %zd",
                 INTJ_NDTYPES, n);
    return NULL;
  }
  /* checks done; commit */
  st->abi.cdata = (uint16_t)off[0];
  st->abi.storage = (uint16_t)off[1];
  st->abi.storage_offset = (uint16_t)off[2];
  st->abi.numel = (uint16_t)off[3];
  st->abi.data_type = (uint16_t)off[4];
  st->abi.s_data = (uint16_t)off[5];
  st->abi.s_nbytes = (uint16_t)off[6];
  memcpy(st->abi.itemsize, PyBytes_AS_STRING(sizes), INTJ_NDTYPES);
{% elif torch_access == 'cxx' %}
  /* The compiler placed `cdata` for us; the probe found where it actually is.
   * They must agree, or this module was compiled against a torch whose
   * THPVariable no longer starts with the tensor. */
  {
    unsigned int off[7];
    PyObject *sizes;
    if (!PyTuple_Check(layout)) {
      PyErr_Format(PyExc_ValueError,
                   "intj: the c++ access mode needs the probed layout to check "
                   "itself against, got %s",
                   Py_TYPE(layout)->tp_name);
      return NULL;
    }
    if (!PyArg_ParseTuple(layout, "IIIIIIIO", &off[0], &off[1], &off[2], &off[3],
                          &off[4], &off[5], &off[6], &sizes))
      return NULL;
    if (off[0] != offsetof(intj_THPVariable, cdata)) {
      PyErr_Format(PyExc_RuntimeError,
                   "intj: this module was compiled expecting the tensor at "
                   "offset %zu of THPVariable, but this torch has it at %u",
                   (size_t)offsetof(intj_THPVariable, cdata), off[0]);
      return NULL;
    }
  }
{% else %}
  if (layout != Py_None) {
    PyErr_SetString(PyExc_ValueError,
                    "intj: this module was built without the shim access mode, "
                    "so it takes no tensor layout");
    return NULL;
  }
{% endif %}

  memcpy(st->abi.dtype_index, index, INTJ_NDTYPES);
  st->abi.ready = 1;
  Py_RETURN_NONE;
}

{% if not no_gpu %}
static void *intj_dlopen(const char *path) {
  void *h = dlopen(path, RTLD_LAZY | RTLD_GLOBAL | RTLD_NOLOAD);
  if (!h)
    h = dlopen(path, RTLD_LAZY | RTLD_GLOBAL);
  if (!h)
    PyErr_Format(PyExc_RuntimeError, "intj: cannot dlopen %s: %s", path,
                 dlerror());
  return h;
}

static void *intj_dlsym(void *handle, const char *name) {
  void *sym = dlsym(handle, name);
  if (!sym)
    PyErr_Format(PyExc_RuntimeError, "intj: missing symbol %s", name);
  return sym;
}
{% endif %}

static int intj_exec(PyObject *m) {
  intj_state *st = (intj_state *)PyModule_GetState(m);

  PyObject *torch = PyImport_ImportModule("torch");
  if (!torch)
    return -1;
  PyObject *tensor = PyObject_GetAttrString(torch, "Tensor");
  PyObject *nn = tensor ? PyObject_GetAttrString(torch, "nn") : NULL;
  PyObject *parameter = nn ? PyObject_GetAttrString(nn, "Parameter") : NULL;
  Py_DECREF(torch);
  Py_XDECREF(nn);
  if (!parameter) {
    Py_XDECREF(tensor);
    return -1;
  }
  st->tensor_type = (PyTypeObject *)tensor;
  st->param_type = (PyTypeObject *)parameter;

  if (intj_intern_names() != 0)
    return -1;
{% if torch_access == 'cpython' %}
  /* The one layout bet this mode makes, and the only one that can check itself. */
  {
    PyObject *t = PyImport_ImportModule("torch");
    if (!t)
      return -1;
    int rc = intj_dtype_selfcheck(t);
    Py_DECREF(t);
    if (rc != 0)
      return -1;
  }
{% endif %}

{% if not no_gpu %}
  void *gpu = intj_dlopen("{{ driver_path }}");
  if (!gpu)
    return -1;
  st->launch = (intj_launch_t)intj_dlsym(gpu, "{{ launch_symbol }}");
  if (!st->launch)
    return -1;
{% if error_style == 'return' %}
  st->error_string = (intj_error_string_ret_t)dlsym(gpu, "{{ error_symbol }}");
{% else %}
  st->error_string = (intj_error_string_out_t)dlsym(gpu, "{{ error_symbol }}");
{% endif %}
{% endif %}

  if (intj_cache_init(&st->cache) != 0) {
    PyErr_NoMemory();
    return -1;
  }
  st->bound_type = (PyTypeObject *)PyType_FromModuleAndSpec(m, &intj_bound_spec, NULL);
  if (!st->bound_type)
    return -1;
  st->bound_type->tp_vectorcall_offset = offsetof(intj_bound_launcher, vectorcall);
  return 0;
}

static int intj_traverse(PyObject *m, visitproc visit, void *arg) {
  intj_state *st = (intj_state *)PyModule_GetState(m);
  Py_VISIT(st->compile_cb);
  Py_VISIT(st->tensor_type);
  Py_VISIT(st->param_type);
  Py_VISIT(st->bound_type);
  return 0;
}

static int intj_clear(PyObject *m) {
  intj_state *st = (intj_state *)PyModule_GetState(m);
  Py_CLEAR(st->compile_cb);
  Py_CLEAR(st->tensor_type);
  Py_CLEAR(st->param_type);
  Py_CLEAR(st->bound_type);
  return 0;
}

/* Frees only intj's own allocations. The hipFunction_t handles are owned by the
 * CompiledKernels the compile callback keeps alive, and are unloaded by triton. */
static void intj_free(void *module) {
  intj_state *st = (intj_state *)PyModule_GetState((PyObject *)module);
  intj_cache_free(&st->cache);
}

static PyMethodDef intj_methods[] = {
    {"entry", (PyCFunction)(void (*)(void))entry, METH_FASTCALL, NULL},
    {"make_bound", (PyCFunction)(void (*)(void))make_bound, METH_FASTCALL, NULL},
    {"spec_key", (PyCFunction)(void (*)(void))spec_key, METH_FASTCALL, NULL},
    {"set_compile_callback", set_compile_callback, METH_O, NULL},
    {"set_torch_version", (PyCFunction)(void (*)(void))set_torch_version,
     METH_FASTCALL, NULL},
    {NULL, NULL, 0, NULL}};

static PyModuleDef_Slot intj_slots[] = {
    {Py_mod_exec, (void *)intj_exec},
    {Py_mod_multiple_interpreters, Py_MOD_MULTIPLE_INTERPRETERS_NOT_SUPPORTED},
    {0, NULL}};

static struct PyModuleDef intj_module = {
    PyModuleDef_HEAD_INIT, "{{ module_name }}", NULL, sizeof(intj_state),
    intj_methods,          intj_slots,          intj_traverse, intj_clear,
    intj_free};

PyMODINIT_FUNC PyInit_{{ module_name }}(void) {
  return PyModuleDef_Init(&intj_module);
}
