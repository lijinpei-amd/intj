/* Generated by intj for {{ kernel_repr }} -- do not edit.
 *
 * entry(device, stream, grid, {% for p in params %}{{ p.name }}{{ ", " if not loop.last }}{% endfor %})
 */
#define PY_SSIZE_T_CLEAN
#include <Python.h>

/* The module reads CPython internals, so it is built for exactly one interpreter:
 * the one that rendered it.  A different Python.h on the include path would
 * compile cleanly and read the wrong layout. */
#if PY_MAJOR_VERSION != {{ python_version[0] }} || PY_MINOR_VERSION != {{ python_version[1] }} || \
    PY_MICRO_VERSION != {{ python_version[2] }}
#error "intj: compiling against the headers of a different CPython than the one running intj"
#endif
#if defined(Py_GIL_DISABLED) != {{ 1 if free_threaded else 0 }}
#error "intj: compiling against headers of the wrong GIL build"
#endif

#define INTJ_CPYTHON_STATIC_COMPILE_HEADER "{{ cpython_static_compile_header }}"
#define INTJ_NWORDS {{ nwords }}
#define INTJ_TORCH_ACCESS_{{ torch_access_mode | upper }} 1
#include "intj_runtime.h"

#define INTJ_NPARAMS {{ params | length }}
#define INTJ_NSLOTS {{ [max_slots, 1] | max }}

typedef struct {
  PyObject *compile_cb;
  PyTypeObject *tensor_type;
  PyTypeObject *param_type;
  intj_torch_abi abi;
  intj_launch_t launch;
{% if error_style == 'return' %}  intj_error_string_ret_t error_string;
{% else %}  intj_error_string_out_t error_string;
{% endif %}
  intj_cache cache;
  intj_mutex mutex; /* the cache and compile_cb, on a free-threaded build */
} intj_state;

static const char *const intj_param_names[INTJ_NPARAMS + 1] = {
{% for p in params %}    "{{ p.name }}",
{% endfor %}    NULL};

/* Parse one grid dimension. Returns -1 on error. */
static int intj_grid_dim(PyObject *o, uint32_t *out) {
  int64_t v;
  if (INTJ_UNLIKELY(!PyLong_CheckExact(o) || intj_as_i64(o, &v) != 0 || v < 0 ||
                    v > 4294967295LL)) {
    PyErr_SetString(PyExc_ValueError,
                    "intj: grid dimensions must be ints in [0, 2**32)");
    return -1;
  }
  *out = (uint32_t)v;
  return 0;
}

static PyObject *entry(PyObject *self, PyObject *const *args, Py_ssize_t nargs) {
  intj_state *st = (intj_state *)PyModule_GetState(self);
  if (INTJ_UNLIKELY(!st->abi.ready)) {
    PyErr_SetString(PyExc_RuntimeError,
                    "intj: set_torch_version has not been called");
    return NULL;
  }
  if (INTJ_UNLIKELY(nargs != 3 + INTJ_NPARAMS)) {
    PyErr_Format(PyExc_TypeError,
                 "intj: %s takes exactly %d arguments (device, stream, grid and "
                 "%d kernel arguments), got %zd",
                 "{{ kernel_repr }}", 3 + INTJ_NPARAMS, INTJ_NPARAMS, nargs);
    return NULL;
  }

  /* device / stream */
  /* One byte of the key holds this, so the upper bound is load-bearing: device
   * 256 would alias device 0 and launch on the wrong context.  It is checked
   * here, with the parse, rather than beside the key build -- a zero-volume
   * grid returns below, before any key exists. */
  int64_t device;
  if (INTJ_UNLIKELY(!PyLong_CheckExact(args[0]) ||
                    intj_as_i64(args[0], &device) != 0 || device < 0 ||
                    device > 255)) {
    PyErr_SetString(PyExc_TypeError, "intj: device must be an int in [0, 256)");
    return NULL;
  }
  uint64_t stream;
  {
    int64_t s;
    if (INTJ_UNLIKELY(!PyLong_CheckExact(args[1]) ||
                      intj_as_i64(args[1], &s) != 0 || s < 0)) {
      PyErr_SetString(PyExc_TypeError,
                      "intj: stream must be a non-negative int handle");
      return NULL;
    }
    stream = (uint64_t)s;
  }

  /* grid */
  uint32_t gx = 1, gy = 1, gz = 1;
  {
    PyObject *g = args[2];
    if (PyLong_CheckExact(g)) {
      if (intj_grid_dim(g, &gx) != 0)
        return NULL;
    } else if (PyTuple_CheckExact(g) || PyList_CheckExact(g)) {
      PyObject **items;
      Py_ssize_t n;
      if (PyTuple_CheckExact(g)) {
        n = PyTuple_GET_SIZE(g);
        items = &PyTuple_GET_ITEM(g, 0);
      } else {
        n = PyList_GET_SIZE(g);
        items = &PyList_GET_ITEM(g, 0);
      }
      if (n < 1 || n > 3) {
        PyErr_SetString(PyExc_ValueError,
                        "intj: grid must have between 1 and 3 dimensions");
        return NULL;
      }
      uint32_t *dims[3] = {&gx, &gy, &gz};
      for (Py_ssize_t i = 0; i < n; i++)
        if (intj_grid_dim(items[i], dims[i]) != 0)
          return NULL;
    } else {
      PyErr_SetString(PyExc_TypeError,
                      "intj: grid must be an int, tuple or list of ints");
      return NULL;
    }
  }
  if (INTJ_UNLIKELY((uint64_t)gx * (uint64_t)gy * (uint64_t)gz == 0))
    Py_RETURN_NONE;

  /* spec key + kernel arguments.  The header accumulates in 32-bit registers --
   * the width the decode already works in -- and each key word gets exactly one
   * store: two adjacent 32-bit stores feeding an 8-byte load would not forward.
   * Every word is assigned rather than OR'd into, so the array needs no
   * initializer; the header's padding bytes come from the zeroed accumulators. */
  uint64_t key[INTJ_NWORDS];
  uint64_t vals[INTJ_NSLOTS];
  int np = 0;
{% for a in range(header_words * 2) %}  uint32_t _a{{ a }} = 0;
{% endfor %}
{% for p in params %}
{% if p.is_constexpr %}
  INTJ_DECODE_CONSTEXPR(args[{{ 3 + loop.index0 }}], _a{{ loop.index0 // 4 }},
                        {{ (loop.index0 % 4) * 8 }}, key[{{ p.cx_word }}],
                        intj_param_names[{{ loop.index0 }}]);
{% else %}
  INTJ_DECODE(st, args[{{ 3 + loop.index0 }}], _a{{ loop.index0 // 4 }},
              {{ (loop.index0 % 4) * 8 }}, vals, np,
              {{ p.spec }}, {{ p.align }}, {{ spec_pointer_range }},
              intj_param_names[{{ loop.index0 }}]);
{% endif %}
{% endfor %}
  _a{{ (params | length) // 4 }} |= (uint32_t)device << {{ ((params | length) % 4) * 8 }};
{% for w in range(header_words) %}  key[{{ w }}] = (uint64_t)_a{{ 2 * w }} | ((uint64_t)_a{{ 2 * w + 1 }} << 32);
{% endfor %}

  uint64_t hash = intj_hash(key);
  INTJ_LOCK(&st->mutex);
  intj_kernel *kernel = intj_cache_get(&st->cache, key, hash);
  INTJ_UNLOCK(&st->mutex);
  if (INTJ_UNLIKELY(!kernel)) {
    /* Cold path: hand the original arguments back to python, which compiles
     * through JITFunction.warmup and validates our spec key against triton's.
     * The lock is never held across it: the callback runs python. */
    INTJ_LOCK(&st->mutex);
    PyObject *cb = st->compile_cb;
    Py_XINCREF(cb);
    INTJ_UNLOCK(&st->mutex);
    if (!cb) {
      PyErr_SetString(PyExc_RuntimeError, "intj: compile callback is not set");
      return NULL;
    }
    PyObject *blob = PyBytes_FromStringAndSize((const char *)key, sizeof(key));
    PyObject *nparams_obj = blob ? PyLong_FromLong(np) : NULL;
    if (!nparams_obj) {
      Py_XDECREF(blob);
      Py_DECREF(cb);
      return NULL;
    }
    PyObject *cb_args[3 + INTJ_NPARAMS];
    cb_args[0] = blob;
    cb_args[1] = nparams_obj;
    cb_args[2] = args[0]; /* device */
    for (int i = 0; i < INTJ_NPARAMS; i++)
      cb_args[3 + i] = args[3 + i];
    PyObject *res = PyObject_Vectorcall(cb, cb_args, 3 + INTJ_NPARAMS, NULL);
    Py_DECREF(cb);
    Py_DECREF(blob);
    Py_DECREF(nparams_obj);
    if (!res)
      return NULL;
    unsigned long long function;
    unsigned int block_dim, shared, nparams;
    if (!PyArg_ParseTuple(res, "KIII", &function, &block_dim, &shared,
                          &nparams)) {
      Py_DECREF(res);
      return NULL;
    }
    Py_DECREF(res);
    /* The callback ran python, so another thread may have filled this key. */
    intj_kernel *fresh = (intj_kernel *)PyMem_RawMalloc(sizeof(intj_kernel));
    if (!fresh)
      return PyErr_NoMemory();
    fresh->function = (void *)(uintptr_t)function;
    fresh->block_dim = block_dim;
    fresh->shared = shared;
    fresh->nparams = nparams;
    INTJ_LOCK(&st->mutex);
    kernel = intj_cache_get(&st->cache, key, hash);
    int failed = 0;
    if (!kernel) {
      failed = intj_cache_put(&st->cache, key, hash, fresh);
      kernel = fresh;
    }
    INTJ_UNLOCK(&st->mutex);
    if (kernel != fresh || failed)
      PyMem_RawFree(fresh);
    if (failed)
      return PyErr_NoMemory();
  }

  if (INTJ_UNLIKELY((uint32_t)np != kernel->nparams)) {
    PyErr_Format(PyExc_RuntimeError,
                 "intj: kernel argument count changed for an identical spec "
                 "key (%d vs %u); this is an intj bug",
                 np, kernel->nparams);
    return NULL;
  }

  /* Launch. Two trailing scratch slots are mandatory on AMD; intj refuses
   * kernels that need non-empty scratch, so they are always null. */
  void *params[INTJ_NSLOTS + 2];
  for (int i = 0; i < np; i++)
    params[i] = &vals[i];
  uint64_t scratch[2] = {0, 0};
  params[np] = &scratch[0];
  params[np + 1] = &scratch[1];

  int32_t status =
      st->launch(kernel->function, gx, gy, gz, kernel->block_dim, 1, 1,
                 kernel->shared, (void *)(uintptr_t)stream, params, NULL);
  if (INTJ_UNLIKELY(status != 0)) {
    const char *message = NULL;
{% if error_style == 'return' %}
    if (st->error_string)
      message = st->error_string(status);
{% else %}
    if (st->error_string)
      st->error_string(status, &message);
{% endif %}
    PyErr_Format(PyExc_RuntimeError, "intj: {{ launch_symbol }} failed: %s",
                 message ? message : "unknown error");
    return NULL;
  }
  Py_RETURN_NONE;
}

/* Debug/test entry point: the spec key intj would compute for these arguments,
 * without compiling or launching anything.  Used by the differential tests to
 * assert that intj's key is never coarser than triton's specialization. */
static PyObject *spec_key(PyObject *self, PyObject *const *args,
                          Py_ssize_t nargs) {
  intj_state *st = (intj_state *)PyModule_GetState(self);
  if (!st->abi.ready) {
    PyErr_SetString(PyExc_RuntimeError,
                    "intj: set_torch_version has not been called");
    return NULL;
  }
  if (nargs != INTJ_NPARAMS) {
    PyErr_Format(PyExc_TypeError, "intj: spec_key takes %d arguments, got %zd",
                 INTJ_NPARAMS, nargs);
    return NULL;
  }
  uint64_t key[INTJ_NWORDS];
  uint64_t vals[INTJ_NSLOTS];
  int np = 0;
  uint32_t device = 0; /* no launch, so no device to key on */
{% for a in range(header_words * 2) %}  uint32_t _a{{ a }} = 0;
{% endfor %}
{% for p in params %}
{% if p.is_constexpr %}
  INTJ_DECODE_CONSTEXPR(args[{{ loop.index0 }}], _a{{ loop.index0 // 4 }},
                        {{ (loop.index0 % 4) * 8 }}, key[{{ p.cx_word }}],
                        intj_param_names[{{ loop.index0 }}]);
{% else %}
  INTJ_DECODE(st, args[{{ loop.index0 }}], _a{{ loop.index0 // 4 }},
              {{ (loop.index0 % 4) * 8 }}, vals, np,
              {{ p.spec }}, {{ p.align }}, {{ spec_pointer_range }},
              intj_param_names[{{ loop.index0 }}]);
{% endif %}
{% endfor %}
  _a{{ (params | length) // 4 }} |= device << {{ ((params | length) % 4) * 8 }};
{% for w in range(header_words) %}  key[{{ w }}] = (uint64_t)_a{{ 2 * w }} | ((uint64_t)_a{{ 2 * w + 1 }} << 32);
{% endfor %}
  return Py_BuildValue("(y#i)", (const char *)key, (Py_ssize_t)sizeof(key), np);
}

static PyObject *set_compile_callback(PyObject *self, PyObject *cb) {
  intj_state *st = (intj_state *)PyModule_GetState(self);
  Py_INCREF(cb);
  INTJ_LOCK(&st->mutex);
  PyObject *old = st->compile_cb;
  st->compile_cb = cb;
  INTJ_UNLOCK(&st->mutex);
  Py_XDECREF(old); /* outside the lock: a finalizer runs python */
  Py_RETURN_NONE;
}

/* set_torch_version((major, minor), layout, dtype_index) -- install the torch ABI.
 *
 * Deliberately not baked into the binary: the offsets come from the torch that
 * is running now, so there is no window in which a cached .so built against one
 * torch is loaded against another. `layout` is None outside RUNTIME_SHIM.
 *
 * Nothing is written into `st->abi` until every argument has been checked, and
 * a configured module cannot be configured again. The method is reachable from
 * python after load, when its kernel cache may already hold entries.
 *
 * Launches read `st->abi` unlocked, so on a free-threaded build this must not
 * race one.  The launcher calls it once, under its load lock, before the module
 * is reachable.
 */
static PyObject *set_torch_version(PyObject *self, PyObject *const *args,
                                   Py_ssize_t nargs) {
  intj_state *st = (intj_state *)PyModule_GetState(self);
  PyObject *layout;
  if (nargs != 3) {
    PyErr_SetString(
        PyExc_TypeError,
        "intj: set_torch_version takes (version, layout, dtype_index)");
    return NULL;
  }
  layout = args[1];

  /* Every mode reads this table -- it is what the key encodes, not how a
   * pointer is computed -- so it is validated here rather than in a branch. */
  const uint8_t *index;
  {
    Py_ssize_t n = PyBytes_Size(args[2]);
    if (n < 0)
      return NULL;
    if (n != INTJ_NDTYPES) {
      PyErr_Format(PyExc_ValueError,
                   "intj: dtype index table must be %d bytes, got %zd",
                   INTJ_NDTYPES, n);
      return NULL;
    }
    index = (const uint8_t *)PyBytes_AS_STRING(args[2]);
    /* The key gives the index five bits.  A larger one would not overflow into
     * the next parameter's byte -- it would shift the pointer code past 127 and
     * alias a scalar tag, so a float32 pointer could key as a 16-divisible
     * int64.  0xFF is the "triton does not take this dtype" sentinel. */
    for (int i = 0; i < INTJ_NDTYPES; i++)
      if (index[i] >= 32u && index[i] != 0xFFu) {
        PyErr_Format(PyExc_ValueError,
                     "intj: dtype index table[%d] is %u; the spec key has five "
                     "bits for it",
                     i, (unsigned)index[i]);
        return NULL;
      }
  }

{% if torch_access_mode == 'runtime_shim' %}
  uint16_t off[7];
  if (!PyTuple_Check(layout)) {
    PyErr_Format(PyExc_ValueError,
                 "intj: this module was built with RUNTIME_SHIM and needs "
                 "a tensor layout, got %s",
                 Py_TYPE(layout)->tp_name);
    return NULL;
  }
  if (PyTuple_GET_SIZE(layout) != 8) {
    PyErr_SetString(PyExc_ValueError,
                    "intj: tensor layout needs seven offsets and an itemsize table");
    return NULL;
  }
  for (int i = 0; i < 7; i++) {
    PyObject *value = PyTuple_GET_ITEM(layout, i);
    if (!PyLong_CheckExact(value)) {
      PyErr_Format(PyExc_ValueError,
                   "intj: tensor layout offset %d must be a 16-bit integer", i);
      return NULL;
    }
    long v = PyLong_AsLong(value);
    if (v < 0 || v > UINT16_MAX || PyErr_Occurred()) {
      PyErr_Clear();
      PyErr_Format(PyExc_ValueError,
                   "intj: tensor layout offset %d must be a 16-bit integer", i);
      return NULL;
    }
    off[i] = (uint16_t)v;
  }
  PyObject *sizes = PyTuple_GET_ITEM(layout, 7);
  Py_ssize_t n = PyBytes_Size(sizes);
  if (n < 0)
    return NULL;
  if (n != INTJ_NDTYPES) {
    PyErr_Format(PyExc_ValueError, "intj: itemsize table must be %d bytes, got %zd",
                 INTJ_NDTYPES, n);
    return NULL;
  }
{% else %}
  if (layout != Py_None) {
    PyErr_SetString(PyExc_ValueError,
                    "intj: this module was built without RUNTIME_SHIM, "
                    "so it takes no tensor layout");
    return NULL;
  }
{% endif %}

  if (st->abi.ready) {
    PyErr_SetString(PyExc_RuntimeError, "intj: torch ABI already installed");
    return NULL;
  }
  /* checks done; commit */
{% if torch_access_mode == 'runtime_shim' %}
  st->abi.cdata = off[0];
  st->abi.storage = off[1];
  st->abi.storage_offset = off[2];
  st->abi.numel = off[3];
  st->abi.data_type = off[4];
  st->abi.s_data = off[5];
  st->abi.s_nbytes = off[6];
  memcpy(st->abi.itemsize, PyBytes_AS_STRING(sizes), INTJ_NDTYPES);
{% endif %}
  memcpy(st->abi.dtype_index, index, INTJ_NDTYPES);
  st->abi.ready = 1;
  Py_RETURN_NONE;
}

static void *intj_dlopen(const char *path) {
  void *h = dlopen(path, RTLD_LAZY | RTLD_GLOBAL | RTLD_NOLOAD);
  if (!h)
    h = dlopen(path, RTLD_LAZY | RTLD_GLOBAL);
  if (!h)
    PyErr_Format(PyExc_RuntimeError, "intj: cannot dlopen %s: %s", path,
                 dlerror());
  return h;
}

static void *intj_dlsym(void *handle, const char *name) {
  void *sym = dlsym(handle, name);
  if (!sym)
    PyErr_Format(PyExc_RuntimeError, "intj: missing symbol %s", name);
  return sym;
}

static int intj_exec(PyObject *m) {
  intj_state *st = (intj_state *)PyModule_GetState(m);

  PyObject *torch = PyImport_ImportModule("torch");
  if (!torch)
    return -1;
  PyObject *tensor = PyObject_GetAttrString(torch, "Tensor");
  PyObject *nn = tensor ? PyObject_GetAttrString(torch, "nn") : NULL;
  PyObject *parameter = nn ? PyObject_GetAttrString(nn, "Parameter") : NULL;
  Py_DECREF(torch);
  Py_XDECREF(nn);
  if (!parameter) {
    Py_XDECREF(tensor);
    return -1;
  }
  st->tensor_type = (PyTypeObject *)tensor;
  st->param_type = (PyTypeObject *)parameter;

  if (intj_intern_names() != 0)
    return -1;
{% if torch_access_mode == 'interpreter' %}
  /* The one layout bet this mode makes, and the only one that can check itself. */
  {
    PyObject *t = PyImport_ImportModule("torch");
    if (!t)
      return -1;
    int rc = intj_dtype_selfcheck(t);
    Py_DECREF(t);
    if (rc != 0)
      return -1;
  }
{% endif %}

  void *gpu = intj_dlopen("{{ driver_path }}");
  if (!gpu)
    return -1;
  st->launch = (intj_launch_t)intj_dlsym(gpu, "{{ launch_symbol }}");
  if (!st->launch)
    return -1;
{% if error_style == 'return' %}
  st->error_string = (intj_error_string_ret_t)dlsym(gpu, "{{ error_symbol }}");
{% else %}
  st->error_string = (intj_error_string_out_t)dlsym(gpu, "{{ error_symbol }}");
{% endif %}

  if (intj_cache_init(&st->cache) != 0) {
    PyErr_NoMemory();
    return -1;
  }
  return 0;
}

static int intj_traverse(PyObject *m, visitproc visit, void *arg) {
  intj_state *st = (intj_state *)PyModule_GetState(m);
  Py_VISIT(st->compile_cb);
  Py_VISIT(st->tensor_type);
  Py_VISIT(st->param_type);
  return 0;
}

static int intj_clear(PyObject *m) {
  intj_state *st = (intj_state *)PyModule_GetState(m);
  Py_CLEAR(st->compile_cb);
  Py_CLEAR(st->tensor_type);
  Py_CLEAR(st->param_type);
  return 0;
}

/* Frees only intj's own allocations. The hipFunction_t handles are owned by the
 * CompiledKernels the compile callback keeps alive, and are unloaded by triton. */
static void intj_free(void *module) {
  intj_state *st = (intj_state *)PyModule_GetState((PyObject *)module);
  intj_cache_free(&st->cache);
}

static PyMethodDef intj_methods[] = {
    {"entry", (PyCFunction)(void (*)(void))entry, METH_FASTCALL, NULL},
    {"spec_key", (PyCFunction)(void (*)(void))spec_key, METH_FASTCALL, NULL},
    {"set_compile_callback", set_compile_callback, METH_O, NULL},
    {"set_torch_version", (PyCFunction)(void (*)(void))set_torch_version,
     METH_FASTCALL, NULL},
    {NULL, NULL, 0, NULL}};

static PyModuleDef_Slot intj_slots[] = {
    {Py_mod_exec, (void *)intj_exec},
#ifdef Py_mod_multiple_interpreters /* 3.12+; older CPython has no such slot */
    {Py_mod_multiple_interpreters, Py_MOD_MULTIPLE_INTERPRETERS_NOT_SUPPORTED},
#endif
#ifdef Py_mod_gil /* 3.13+: a free-threaded build keeps the GIL off for it */
    {Py_mod_gil, Py_MOD_GIL_NOT_USED},
#endif
    {0, NULL}};

static struct PyModuleDef intj_module = {
    PyModuleDef_HEAD_INIT, "{{ module_name }}", NULL, sizeof(intj_state),
    intj_methods,          intj_slots,          intj_traverse, intj_clear,
    intj_free};

PyMODINIT_FUNC PyInit_{{ module_name }}(void) {
  return PyModuleDef_Init(&intj_module);
}
