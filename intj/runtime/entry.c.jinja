                           PyTuple_GET_ITEM(bound->grid_hidden, {{ hidden_params.index(p) }})) != 0) goto fail;
{% endif %}
{% endfor %}
  {
    PyObject *grid_args[1] = {meta};
    PyObject *g = PyObject_Vectorcall(bound->grid_py, grid_args, 1, NULL);
    Py_DECREF(meta);
    meta = NULL;
    if (!g)
      return NULL;
