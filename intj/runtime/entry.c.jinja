static INTJ_ALWAYS_INLINE int intj_parse_call(intj_state *st,
                                              PyObject *const *args, Py_ssize_t nargs,
                                              int64_t *device, uint64_t *stream) {
  if (INTJ_UNLIKELY(!st->abi.ready)) {
    PyErr_SetString(PyExc_RuntimeError,
                    "intj: set_torch_version has not been called");
    return -1;
  }
  if (INTJ_UNLIKELY(nargs != {{ ncontrols }} + INTJ_NDYN + INTJ_NPARAMS)) {
    PyErr_Format(PyExc_TypeError,
                 "intj: %s takes exactly %d arguments ({{ 'device, ' if not fixed_device }}stream{% if grid_cpp_source %}, grid extras{% elif not grid_py_mode %}, {{ 'grid' if grid_arg is none else 'grid dimensions' }}{% endif %}, "
                 "%d dynamic values and %d kernel arguments), got %zd",
                 "{{ kernel_repr }}", {{ ncontrols }} + INTJ_NDYN + INTJ_NPARAMS, INTJ_NDYN,
                 INTJ_NPARAMS, nargs);
    return -1;
  }

  /* device / stream */
{% if not fixed_device %}
  /* One byte of the key holds this, so the upper bound is load-bearing: device
   * 256 would alias device 0 and launch on the wrong context.  It is checked
   * here, with the parse, rather than beside the key build -- a zero-volume
   * grid returns below, before any key exists. */
  if (INTJ_UNLIKELY(!PyLong_CheckExact(args[0]) ||
                    intj_as_i64(args[0], device) != 0 || *device < 0 ||
                    *device > 255)) {
    PyErr_SetString(PyExc_TypeError, "intj: device must be an int in [0, 256)");
    return -1;
  }
{% endif %}
  {
    int64_t s;
    if (INTJ_UNLIKELY(!PyLong_CheckExact(args[{{ 0 if fixed_device else 1 }}]) ||
                      intj_as_i64(args[{{ 0 if fixed_device else 1 }}], &s) != 0 || s < 0)) {
      PyErr_SetString(PyExc_TypeError,
                      "intj: stream must be a non-negative int handle");
      return -1;
    }
    *stream = (uint64_t)s;
  }
  return 0;
}

/* args starts at grid controls, then dynamic values, then the public kernel arguments. */
static PyObject *intj_call(intj_state *st,
                           int64_t device_ordinal, uint64_t stream,
                           PyObject *const *args, Py_ssize_t nargs,
                           intj_bound_launcher *bound) {
  (void)nargs;
  PyObject *const *dyn = args + {{ grid_count }};
  PyObject *const *kargs = dyn + INTJ_NDYN;
  /* grid */
  uint32_t gx = 1, gy = 1, gz = 1;
{% if grid_arg is not none %}
  uint32_t *dims[3] = {&gx, &gy, &gz};
  for (int i = 0; i < {{ grid_arg }}; i++) {
    if (intj_grid_dim(args[i], dims[i]) != 0)
      return NULL;
  }
{% elif grid_cpp_source and not tuned %}
  uint32_t dims[3] = {1, 1, 1};
  if (intj_eval_grid(args, dims) != 0)
    return NULL;
  gx = dims[0]; gy = dims[1]; gz = dims[2];
{% elif grid_py_mode and not tuned %}
  if (INTJ_UNLIKELY(!bound || !bound->grid_py)) {
    PyErr_SetString(PyExc_TypeError, "intj: grid_py requires its bound launcher");
    return NULL;
  }
  PyObject *meta = PyDict_New();
  if (!meta)
    return NULL;
{% for p in params %}
  if (PyDict_SetItemString(meta, intj_param_names[{{ p.index }}],
                           {{ 'kargs[' ~ p.call_index ~ ']' if p.call_index is not none else 'PyTuple_GET_ITEM(bound->grid_hidden, ' ~ hidden_params.index(p) ~ ')' }}) != 0) {
    Py_DECREF(meta);
    return NULL;
  }
{% endfor %}
  PyObject *grid_args[1] = {meta};
  PyObject *g = PyObject_Vectorcall(bound->grid_py, grid_args, 1, NULL);
  Py_DECREF(meta);
  if (!g)
    return NULL;
  int grid_status = intj_grid_object(g, &gx, &gy, &gz);
  Py_DECREF(g);
  if (grid_status != 0)
    return NULL;
{% elif grid_cpp_source or grid_py_mode %}
  /* tuned: the grid may read tuned values, so it is evaluated after lookup */
{% else %}
  if (intj_grid_object(args[0], &gx, &gy, &gz) != 0)
    return NULL;
{% endif %}
{% if not return_compiled %}
  if (INTJ_UNLIKELY(gx == 0 || gy == 0 || gz == 0))
    Py_RETURN_NONE;
{% endif %}

  /* Key words are accumulated in registers and written once after decoding. */
  uint64_t key[INTJ_NWORDS];
  uint64_t vals[INTJ_NSLOTS];
  int np = 0;
{% if tuned %}
  int64_t comp[{{ [2 * ncomp, 1] | max }}];
{% endif %}
  if (intj_pack(st, dyn, kargs, key, vals, &np, (uint32_t)device_ordinal, bound{{ ', comp' if tuned }}) != 0)
    return NULL;

{% if tuned %}
  int64_t dep[{{ [2 * ndeps, 1] | max }}];
  int missed = 0;
  intj_final *kernel = intj_walk(st, bound, kargs, key, comp, dep, &missed);
  if (INTJ_UNLIKELY(!kernel)) {
    if (missed < 0)
      return NULL;
    return intj_tuned_fill(st, bound, key, np, device_ordinal, stream,
                           gx, gy, gz, args, comp, dep);
  }
  (void)dep;
{% if grid_py_mode %}
  /* grid_py runs Python: leave the lock with a copy of the record. */
  intj_final copy = *kernel;
  Py_XINCREF(copy.meta);
{% if return_compiled %}
  Py_XINCREF(copy.k.compiled);
{% endif %}
  INTJ_RWUNLOCK(&bound->lock);
  PyObject *result = intj_tuned_grid_py_launch(st, bound, &copy, stream, kargs, vals, np);
  Py_XDECREF(copy.meta);
{% if return_compiled %}
  Py_XDECREF(copy.k.compiled);
{% endif %}
  return result;
{% else %}
{% if grid_cpp_source %}
  /* ponytail: evaluated under the read lock, so a grid error allocates while
   * holding it; a free-threaded finalizer that re-enters this launcher on a
   * miss would deadlock.  Evaluate from a copied dep array if that is seen. */
  uint32_t dims[3] = {1, 1, 1};
  if (intj_eval_grid(args, dep, dims) != 0) {
    INTJ_RWUNLOCK(&bound->lock);
    return NULL;
  }
  gx = dims[0]; gy = dims[1]; gz = dims[2];
{% endif %}
  /* falls through to the shared launch tail below */
{% endif %}
{% else %}
  INTJ_RDLOCK(&bound->lock);
{% if nwords %}
  intj_final *kernel = intj_cache_lookup(INTJ_BOUND_CACHE_OF(bound), key);
{% else %}
  intj_final *kernel = (intj_final *)bound->fixed_kernel;
{% endif %}
  if (INTJ_UNLIKELY(!kernel)) {
    INTJ_RWUNLOCK(&bound->lock);
    if (intj_fill(st, bound, key, np, device_ordinal, dyn) != 0)
      return NULL;
    INTJ_RDLOCK(&bound->lock);
{% if nwords %}
    kernel = intj_cache_lookup(INTJ_BOUND_CACHE_OF(bound), key);
{% else %}
    kernel = (intj_final *)bound->fixed_kernel;
{% endif %}
  }
{% endif %}
{% if not (tuned and grid_py_mode) %}

  /* Held through the launch: `kernel` lives in the map.  Errors are raised
   * after the unlock, because raising allocates and can run Python. */
{% if return_compiled %}
  PyObject *out = NULL;
{% endif %}
  uint32_t recorded_np = kernel->k.nparams;
  int32_t status = 0;
  if (INTJ_LIKELY((uint32_t)np == recorded_np)) {
{% if not no_gpu %}
{% if return_compiled or grid_cpp_source and tuned %}
    if (gx && gy && gz)
{% endif %}
      status = intj_launch(st, &kernel->k, gx, gy, gz, stream, vals, np);
{% endif %}
{% if return_compiled %}
    if (!status)
      out = Py_NewRef(kernel->k.compiled);
{% endif %}
  }
  INTJ_RWUNLOCK(&bound->lock);
  if (INTJ_UNLIKELY((uint32_t)np != recorded_np)) {
    PyErr_Format(PyExc_RuntimeError,
                 "intj: kernel argument count changed for an identical spec "
                 "key (%d vs %u); this is an intj bug",
                 np, recorded_np);
    return NULL;
  }
{% if not no_gpu %}
  if (INTJ_UNLIKELY(status != 0))
    return intj_launch_error(st, status);
{% endif %}
{% if return_compiled %}
  return out;
{% else %}
  /* Not Py_NewRef(Py_None) under the lock: from 3.12 None is immortal and
   * Py_RETURN_NONE is a plain return, where Py_NewRef still tests the count. */
  Py_RETURN_NONE;
{% endif %}
{% endif %}
}

{% set guarded = fixed_device or bound_params or grid_py_mode or tuned %}
static PyObject *intj_bound_entry(PyObject *self, PyObject *const *args,
                                 Py_ssize_t nargs) {
  intj_bound_launcher *bound = (intj_bound_launcher *)self;
  intj_state *st = (intj_state *)bound->state;
  if (INTJ_UNLIKELY(!st)) {
    PyErr_SetString(PyExc_RuntimeError, "intj: bound launcher has been cleared");
    return NULL;
  }
  int64_t device{{ ' = bound->device_ordinal' if fixed_device }};
  uint64_t stream;
  if (intj_parse_call(st, args, nargs, &device, &stream) != 0)
    return NULL;
{% if guarded %}
  /* CPython's specialized builtin call bypasses its vectorcall recursion guard. */
  if (Py_EnterRecursiveCall(" while calling an intj launcher"))
    return NULL;
{% endif %}
  PyObject *result = NULL;
#ifdef __cplusplus
  try {
#endif
    result = intj_call(st, device, stream, args + {{ 1 if fixed_device else 2 }},
                        nargs - {{ 1 if fixed_device else 2 }}, bound);
#ifdef __cplusplus
  } catch (const std::bad_alloc &) {
    PyErr_NoMemory();
  } catch (const std::exception &error) {
    PyErr_SetString(PyExc_RuntimeError, error.what());
  } catch (...) {
    PyErr_SetString(PyExc_RuntimeError, "intj: C++ exception in bound launcher");
  }
#endif
{% if guarded %}
  Py_LeaveRecursiveCall();
{% endif %}
  return result;
}

static int intj_bound_traverse(PyObject *self, visitproc visit, void *arg) {
  intj_bound_launcher *bound = (intj_bound_launcher *)self;
  intj_bound_tail *tail = INTJ_TAIL(bound);
  /* `_intj_lazy` visits the type and the module; never twice */
  Py_VISIT(bound->grid_py);
  Py_VISIT(bound->grid_hidden);
  Py_VISIT(bound->compile_cb);
  Py_VISIT(bound->intern);
  for (int k = 0; k < INTJ_NMEMO; k++)
    Py_VISIT(tail->memo[k].obj);
  {
    int err = intj_objtab_traverse(bound, &tail->objtab, visit, arg);
    if (err)
      return err;
  }
  for (int i = 0; i < INTJ_NBOUND; i++)
    Py_VISIT(tail->owners[i]);
{% if (return_compiled or (tuned and grid_py_mode)) and nwords %}
  if (bound->cache_ready && bound->state)
    return intj_cache_traverse(bound, visit, arg);
{% elif return_compiled and fixed_device %}
  if (bound->state) {
    intj_snapshot s = {NULL, 0, 0};
    INTJ_RDLOCK(&bound->lock);
    int failed = bound->fixed_kernel ? intj_final_collect((intj_final *)bound->fixed_kernel, &s) : 0;
    INTJ_RWUNLOCK(&bound->lock);
    return intj_snapshot_visit(&s, failed, visit, arg);
  }
{% endif %}
  return 0;
}

static int intj_bound_clear(PyObject *self) {
  intj_bound_launcher *bound = (intj_bound_launcher *)self;
  intj_bound_tail *tail = INTJ_TAIL(bound);
  /* Mark closed before dropping owners whose finalizers can reenter Python. */
  bound->state = NULL;
  Py_CLEAR(bound->module);
  Py_CLEAR(bound->grid_py);
  Py_CLEAR(bound->grid_hidden);
  Py_CLEAR(bound->compile_cb);
  Py_CLEAR(bound->intern);
  for (int k = 0; k < INTJ_NMEMO; k++)
    Py_CLEAR(tail->memo[k].obj);
  intj_objtab_clear(&tail->objtab);
  for (int i = 0; i < INTJ_NBOUND; i++) {
    Py_CLEAR(tail->owners[i]);
#if defined(INTJ_TORCH_ACCESS_STATIC_COMPILE)
    delete (at::Tensor *)tail->tensors[i];
    tail->tensors[i] = NULL;
#endif
  }
{% if nwords %}
  if (bound->cache_ready) {
    bound->cache_ready = 0;
    intj_cache_free(INTJ_BOUND_CACHE_OF(bound), INTJ_V0_RELEASE);
  }
{% elif fixed_device %}
  intj_final *kernel = (intj_final *)bound->fixed_kernel;
  bound->fixed_kernel = NULL;
  if (kernel) {
    intj_final_release(kernel);
    PyMem_RawFree(kernel);
  }
{% endif %}
  return 0;
}

/* init_bound(header, callback, interner, [grid_py, fixed values], [device], *bound)
 * -> the entry's address.  Fills an unbuilt `_intj_lazy` header in place.  On
 * failure the header is left unbuilt, so the launcher's next call retries.
 * `callback` is this launcher's miss callback: the tuned callback, or a
 * per-launcher wrapper of the module's compile function.  `interner` is the
 * launcher's own intern table: object value -> id, or None if unsupported. */
static PyObject *init_bound(PyObject *self, PyObject *const *args, Py_ssize_t nargs) {
  intj_state *st = (intj_state *)PyModule_GetState(self);
  if (nargs != 3 + {{ bound_arg_offset + grid_py_offset }} + INTJ_NBOUND) {
    PyErr_Format(PyExc_TypeError, "intj: init_bound takes %d arguments, got %zd",
                 3 + {{ bound_arg_offset + grid_py_offset }} + INTJ_NBOUND, nargs);
    return NULL;
  }
  PyTypeObject *type = Py_TYPE(args[0]);
  intj_bound_launcher *bound = (intj_bound_launcher *)args[0];
  if (type->tp_basicsize != (Py_ssize_t)sizeof(intj_bound_header) || type->tp_itemsize != 1 ||
      Py_SIZE(bound) != (Py_ssize_t)sizeof(intj_bound_tail) || bound->state || bound->module) {
    PyErr_SetString(PyExc_TypeError,
                    "intj: init_bound needs an unbuilt launcher sized for this module");
    return NULL;
  }
  PyObject *callback = args[1];
  if (!PyCallable_Check(callback)) {
    PyErr_SetString(PyExc_TypeError, "intj: init_bound needs the launcher's miss callback");
    return NULL;
  }
  PyObject *interner = args[2];
  if (!PyCallable_Check(interner)) {
    PyErr_SetString(PyExc_TypeError, "intj: init_bound needs the launcher's interner");
    return NULL;
  }
  args += 3;
  if (!st->abi.ready) {
    PyErr_SetString(PyExc_RuntimeError, "intj: set_torch_version has not been called");
    return NULL;
  }
{% if grid_py_mode %}
  if (!PyCallable_Check(args[0]) || !PyTuple_CheckExact(args[1]) ||
      PyTuple_GET_SIZE(args[1]) != {{ hidden_params | length }}) {
    PyErr_SetString(PyExc_TypeError,
                    "intj: init_bound needs a callable grid_py and a fixed-value tuple");
    return NULL;
  }
{% endif %}
{% if fixed_device %}
  int64_t ordinal;
  if (!PyLong_CheckExact(args[{{ grid_py_offset }}]) ||
      intj_as_i64(args[{{ grid_py_offset }}], &ordinal) != 0 ||
      ordinal < 0 || ordinal > INT32_MAX) {
    PyErr_SetString(PyExc_TypeError, "intj: device ordinal must be an int in [0, 2**31)");
    return NULL;
  }
{% endif %}
#ifdef __cplusplus
  try {
#endif
    bound->module = Py_NewRef(self);
    bound->compile_cb = Py_NewRef(callback);
    bound->intern = Py_NewRef(interner);
    {
      /* optional: the type the object table keys by `name` (tl.dtype) */
      PyObject *dtype_type = PyObject_GetAttrString(interner, "dtype_type");
      if (dtype_type && PyType_Check(dtype_type))
        INTJ_TAIL(bound)->objtab.dtype_type = dtype_type;
      else if (dtype_type)
        Py_DECREF(dtype_type);
      else if (PyErr_ExceptionMatches(PyExc_AttributeError))
        PyErr_Clear();
      else
        goto fail;
    }
{% if grid_py_mode %}
    bound->grid_py = Py_NewRef(args[0]);
    bound->grid_hidden = Py_NewRef(args[1]);
{% endif %}
{% if fixed_device %}
    bound->device_ordinal = ordinal;
{% if no_gpu %}
    bound->device_handle = (int32_t)ordinal;
{% else %}
    int32_t status = st->device_get(&bound->device_handle, (int32_t)ordinal);
    if (status != 0) {
      const char *message = NULL;
{% if error_style == 'return' %}
      if (st->error_string)
        message = st->error_string(status);
{% else %}
      if (st->error_string)
        st->error_string(status, &message);
{% endif %}
      PyErr_Format(PyExc_RuntimeError, "intj: {{ device_symbol }} failed: %s",
                   message ? message : "unknown error");
      goto fail;
    }
{% endif %}
{% endif %}
{% if nwords %}
    if (intj_cache_init(INTJ_BOUND_CACHE_OF(bound)) != 0) {
      PyErr_NoMemory();
      goto fail;
    }
    bound->cache_ready = 1;
{% endif %}
{% for p in bound_params %}
{% set i = p.index %}
{% set a = p.annotation %}
{% set arg_index = loop.index0 + bound_arg_offset + grid_py_offset %}
{% if a.bind_value == 'tensor' %}
    if (intj_bind_tensor(bound, {{ loop.index0 }}, args[{{ arg_index }}],
                          st->tensor_type, st->param_type, intj_param_names[{{ i }}]) != 0)
      goto fail;
{% else %}
    intj_decoded decoded_{{ i }};
    if (intj_decode_pointer(&st->abi, st->tensor_type, st->param_type,
                             args[{{ arg_index }}], intj_param_names[{{ i }}], &decoded_{{ i }}) != 0)
      goto fail;
{% set checks = [] %}
{% if verify_annotation %}
{% set matches = pointer_types | selectattr('0', 'equalto', a.types[0]) | list %}
{% set _ = checks.append(('(decoded_' ~ i ~ '.kind != INTJ_VALUE_TENSOR || ' ~ ('intj_infer_type(&decoded_' ~ i ~ ') == ' ~ type_code(a.types[0]) if matches else '0') ~ ')', 'type', 'TypeError')) %}
{% if a.aligned_16 == 'assume' %}
{% set _ = checks.append(('(decoded_' ~ i ~ '.bits & 15u) == 0', 'aligned_16', 'ValueError')) %}
{% endif %}
{% endif %}
{% if checks %}
    int valid_{{ i }} = {% for expression, message, error in checks %}({{ expression }}){{ ' && ' if not loop.last }}{% endfor %};
    if (INTJ_UNLIKELY(!valid_{{ i }})) {
{% for expression, message, error in checks %}
      if (!({{ expression }})) {
        PyErr_Format(PyExc_{{ error }}, "intj: argument '%s' violates {{ message }}",
                     intj_param_names[{{ i }}]);
        goto fail;
      }
{% endfor %}
    }
    INTJ_ASSUME(valid_{{ i }});
{% endif %}
    INTJ_TAIL(bound)->pointer_bits[{{ loop.index0 }}] = decoded_{{ i }}.bits;
    if (!PyLong_CheckExact(args[{{ arg_index }}]))
      INTJ_TAIL(bound)->owners[{{ loop.index0 }}] = Py_NewRef(args[{{ arg_index }}]);
{% endif %}
{% endfor %}
    PyObject *entry = PyLong_FromVoidPtr((void *)intj_bound_entry);
    if (!entry)
      goto fail;
    bound->traverse = intj_bound_traverse;
    bound->clear = intj_bound_clear;
    bound->state = st; /* last: the entry reads it first */
    return entry;
#ifdef __cplusplus
  } catch (const std::bad_alloc &) {
    PyErr_NoMemory();
  } catch (const std::exception &error) {
    PyErr_SetString(PyExc_RuntimeError, error.what());
  } catch (...) {
    PyErr_SetString(PyExc_RuntimeError, "intj: C++ exception while binding arguments");
  }
#endif
fail:
  intj_bound_clear((PyObject *)bound); /* drops whatever was filled; the header stays unbuilt */
  return NULL;
}

static PyObject *header_size(PyObject *self, PyObject *unused) {
  (void)self;
  (void)unused;
  return PyLong_FromSize_t(sizeof(intj_bound_header));
}

/* Debug/test entry point: the spec key intj would compute for these arguments,
 * without compiling or launching anything.  Used by the differential tests to
 * assert that intj's key is never coarser than triton's specialization. */
static PyObject *spec_key(PyObject *self, PyObject *const *args,
                          Py_ssize_t nargs) {
  intj_state *st = (intj_state *)PyModule_GetState(self);
  int64_t device = 0;
  if (!st->abi.ready) {
    PyErr_SetString(PyExc_RuntimeError, "intj: set_torch_version has not been called");
    return NULL;
  }
  if (nargs != 2 + INTJ_NDYN + INTJ_NPARAMS || !PyCFunction_Check(args[0]) ||
      !PyLong_CheckExact(args[1]) || intj_as_i64(args[1], &device) != 0 ||
      device < 0 || device > 255) {
    PyErr_Format(PyExc_TypeError,
                 "intj: spec_key(launcher, device, *%d dynamic values, *%d public args)",
                 INTJ_NDYN, INTJ_NPARAMS);
    return NULL;
  }
  PyObject *owner = PyCFunction_GET_SELF(args[0]);
  if (!owner || Py_TYPE(owner)->tp_basicsize != (Py_ssize_t)sizeof(intj_bound_header) ||
      ((intj_bound_launcher *)owner)->module != self) {
    PyErr_SetString(PyExc_TypeError, "intj: spec_key needs a built launcher of this module");
    return NULL;
  }
  intj_bound_launcher *bound = (intj_bound_launcher *)owner;
  uint64_t key[INTJ_NWORDS];
  uint64_t vals[INTJ_NSLOTS];
  int np = 0;
{% if tuned %}
  int64_t comp[{{ [2 * ncomp, 1] | max }}];
{% endif %}
  if (intj_pack(st, args + 2, args + 2 + INTJ_NDYN, key, vals, &np, {{ '(uint32_t)bound->device_ordinal' if fixed_device else '(uint32_t)device' }}, bound{{ ', comp' if tuned }}) != 0)
    return NULL;
  return Py_BuildValue("(y#i)", (const char *)key, (Py_ssize_t)INTJ_KEY_BYTES, np);
}

{% if tuned %}
/* Debug: the key of every level this call would walk, and whether its final
 * record exists.  key_chain(launcher, device, *dynamic, *public_args) -> ((bytes, ...), found) */
static PyObject *key_chain(PyObject *self, PyObject *const *args, Py_ssize_t nargs) {
  intj_state *st = (intj_state *)PyModule_GetState(self);
  int64_t device = 0;
  if (nargs != 2 + INTJ_NDYN + INTJ_NPARAMS || !PyCFunction_Check(args[0]) ||
      !PyLong_CheckExact(args[1]) || intj_as_i64(args[1], &device) != 0 ||
      device < 0 || device > 255) {
    PyErr_SetString(PyExc_TypeError, "intj: key_chain(launcher, device, *dynamic, *public_args)");
    return NULL;
  }
  PyObject *owner = PyCFunction_GET_SELF(args[0]);
  if (!owner || Py_TYPE(owner)->tp_basicsize != (Py_ssize_t)sizeof(intj_bound_header) ||
      ((intj_bound_launcher *)owner)->module != self ||
      !((intj_bound_launcher *)owner)->cache_ready) {
    PyErr_SetString(PyExc_TypeError, "intj: key_chain needs a live launcher of this module");
    return NULL;
  }
  intj_bound_launcher *bound = (intj_bound_launcher *)owner;
  uint64_t key[INTJ_NWORDS];
  uint64_t vals[INTJ_NSLOTS];
  int64_t comp[{{ [2 * ncomp, 1] | max }}];
  int64_t dep[{{ [2 * ndeps, 1] | max }}];
  int np = 0;
  if (intj_pack(st, args + 2, args + 2 + INTJ_NDYN, key, vals, &np, {{ '(uint32_t)bound->device_ordinal' if fixed_device else '(uint32_t)device' }}, bound, comp) != 0)
    return NULL;
  int missed = 0;
  intj_final *kernel = intj_walk(st, bound, args + 2 + INTJ_NDYN, key, comp, dep, &missed);
  if (kernel)
    INTJ_RWUNLOCK(&bound->lock);
  else if (missed < 0)
    return NULL;
  int walked = kernel ? {{ levels }} : missed + 1;
  static const int offsets[] = { {% for n in range(levels) %}{{ comp_offset[n] }}, {% endfor %}0 };
  static const int counts[] = { {% for n in range(levels) %}{{ tuning.computed[n] }}, {% endfor %}0 };
  (void)offsets; (void)counts;
  PyObject *keys = PyTuple_New(walked);
  if (!keys)
    return NULL;
  for (int n = 0; n < walked; n++) {
    PyObject *item = n == 0 ? PyBytes_FromStringAndSize((const char *)key, INTJ_KEY_BYTES)
                            : PyBytes_FromStringAndSize((const char *)(comp + 2 * offsets[n]),
                                                        16 * counts[n]);
    if (!item) {
      Py_DECREF(keys);
      return NULL;
    }
    PyTuple_SET_ITEM(keys, n, item);
  }
  return Py_BuildValue("(NO)", keys, kernel ? Py_True : Py_False);
}
{% endif %}

/* set_torch_version((major, minor), layout, dtype_index) -- install the torch ABI.
 *
 * RUNTIME_SHIM installs offsets from the torch running now. STATIC_COMPILE can
 * check its compiled cdata offset against that layout when one is verified;
 * INTERPRETER takes no layout.
 *
 * Nothing is written into `st->abi` until every argument has been checked, and
 * a configured module cannot be configured again. The method is reachable from
 * python after load, when its kernel cache may already hold entries.
 *
 * Launches read `st->abi` unlocked, so on a free-threaded build this must not
 * race one.  The launcher calls it once, under its load lock, before the module
 * is reachable.
 */
static PyObject *set_torch_version(PyObject *self, PyObject *const *args,
                                   Py_ssize_t nargs) {
  intj_state *st = (intj_state *)PyModule_GetState(self);
  PyObject *layout;
  if (nargs != 3) {
    PyErr_SetString(
        PyExc_TypeError,
        "intj: set_torch_version takes (version, layout, dtype_index)");
    return NULL;
  }
  layout = args[1];

  /* Every mode reads this table -- it is what the key encodes, not how a
   * pointer is computed -- so it is validated here rather than in a branch. */
  const uint8_t *index;
  {
    Py_ssize_t n = PyBytes_Size(args[2]);
    if (n < 0)
      return NULL;
    if (n != INTJ_NDTYPES) {
      PyErr_Format(PyExc_ValueError,
                   "intj: dtype index table must be %d bytes, got %zd",
                   INTJ_NDTYPES, n);
      return NULL;
    }
    index = (const uint8_t *)PyBytes_AS_STRING(args[2]);
    /* The key gives the index five bits.  A larger one would not overflow into
     * the next parameter's byte -- it would shift the pointer code past 127 and
     * alias a scalar tag, so a float32 pointer could key as a 16-divisible
     * int64.  0xFF is the "triton does not take this dtype" sentinel. */
    for (int i = 0; i < INTJ_NDTYPES; i++)
      if (index[i] >= 32u && index[i] != 0xFFu) {
        PyErr_Format(PyExc_ValueError,
                     "intj: dtype index table[%d] is %u; the spec key has five "
                     "bits for it",
                     i, (unsigned)index[i]);
        return NULL;
      }
  }

{% if torch_access_mode == 'runtime_shim' %}
  uint16_t off[7];
  if (!PyTuple_Check(layout)) {
    PyErr_Format(PyExc_ValueError,
                 "intj: this module was built with RUNTIME_SHIM and needs "
                 "a tensor layout, got %s",
                 Py_TYPE(layout)->tp_name);
    return NULL;
  }
  if (PyTuple_GET_SIZE(layout) != 8) {
    PyErr_SetString(PyExc_ValueError,
                    "intj: tensor layout needs seven offsets and an itemsize table");
    return NULL;
  }
  for (int i = 0; i < 7; i++) {
    PyObject *value = PyTuple_GET_ITEM(layout, i);
    if (!PyLong_CheckExact(value)) {
      PyErr_Format(PyExc_ValueError,
                   "intj: tensor layout offset %d must be a 16-bit integer", i);
      return NULL;
    }
    long v = PyLong_AsLong(value);
    if (v < 0 || v > UINT16_MAX || PyErr_Occurred()) {
      PyErr_Clear();
      PyErr_Format(PyExc_ValueError,
                   "intj: tensor layout offset %d must be a 16-bit integer", i);
      return NULL;
    }
    off[i] = (uint16_t)v;
  }
  PyObject *sizes = PyTuple_GET_ITEM(layout, 7);
  Py_ssize_t n = PyBytes_Size(sizes);
  if (n < 0)
    return NULL;
  if (n != INTJ_NDTYPES) {
    PyErr_Format(PyExc_ValueError, "intj: itemsize table must be %d bytes, got %zd",
                 INTJ_NDTYPES, n);
    return NULL;
  }
  size_t absolute_cdata = (size_t)off[0] + sizeof(PyObject);
  if (absolute_cdata > UINT16_MAX) {
    PyErr_SetString(PyExc_ValueError,
                    "intj: tensor layout cdata plus PyObject header must fit a 16-bit offset");
    return NULL;
  }
{% elif torch_access_mode == 'static_compile' %}
  if (layout != Py_None) {
    if (!PyTuple_Check(layout) || PyTuple_GET_SIZE(layout) != 8 ||
        !PyLong_CheckExact(PyTuple_GET_ITEM(layout, 0))) {
      PyErr_SetString(PyExc_ValueError,
                      "intj: STATIC_COMPILE layout must be eight entries with a cdata offset");
      return NULL;
    }
    long relative = PyLong_AsLong(PyTuple_GET_ITEM(layout, 0));
    if (relative < 0 || relative > UINT16_MAX || PyErr_Occurred()) {
      PyErr_Clear();
      PyErr_SetString(PyExc_ValueError,
                      "intj: STATIC_COMPILE cdata offset must be a 16-bit integer");
      return NULL;
    }
    size_t absolute = (size_t)relative + sizeof(PyObject);
    if (absolute != offsetof(intj_THPVariable, cdata)) {
      PyErr_Format(PyExc_RuntimeError,
                   "intj: STATIC_COMPILE expects tensor cdata at offset %zu, "
                   "but this torch has it at %zu",
                   (size_t)offsetof(intj_THPVariable, cdata), absolute);
      return NULL;
    }
  }
{% else %}
  if (layout != Py_None) {
    PyErr_SetString(PyExc_ValueError,
                    "intj: this module was built without RUNTIME_SHIM, "
                    "so it takes no tensor layout");
    return NULL;
  }
{% endif %}

  if (st->abi.ready) {
    PyErr_SetString(PyExc_RuntimeError, "intj: torch ABI already installed");
    return NULL;
  }
  /* checks done; commit */
{% if torch_access_mode == 'runtime_shim' %}
  st->abi.cdata = (uint16_t)absolute_cdata;
  st->abi.storage = off[1];
  st->abi.storage_offset = off[2];
  st->abi.numel = off[3];
  st->abi.data_type = off[4];
  st->abi.s_data = off[5];
  st->abi.s_nbytes = off[6];
  memcpy(st->abi.itemsize, PyBytes_AS_STRING(sizes), INTJ_NDTYPES);
{% endif %}
  memcpy(st->abi.dtype_index, index, INTJ_NDTYPES);
  st->abi.ready = 1;
  Py_RETURN_NONE;
}

{% if not no_gpu %}
static void *intj_dlopen(const char *path) {
  void *h = dlopen(path, RTLD_LAZY | RTLD_GLOBAL | RTLD_NOLOAD);
  if (!h)
    h = dlopen(path, RTLD_LAZY | RTLD_GLOBAL);
  if (!h)
    PyErr_Format(PyExc_RuntimeError, "intj: cannot dlopen %s: %s", path,
                 dlerror());
  return h;
}

static void *intj_dlsym(void *handle, const char *name) {
  void *sym = dlsym(handle, name);
  if (!sym)
    PyErr_Format(PyExc_RuntimeError, "intj: missing symbol %s", name);
  return sym;
}
{% endif %}

static int intj_exec(PyObject *m) {
  intj_state *st = (intj_state *)PyModule_GetState(m);

  PyObject *torch = PyImport_ImportModule("torch");
  if (!torch)
    return -1;
  PyObject *tensor = PyObject_GetAttrString(torch, "Tensor");
  PyObject *nn = tensor ? PyObject_GetAttrString(torch, "nn") : NULL;
  PyObject *parameter = nn ? PyObject_GetAttrString(nn, "Parameter") : NULL;
  Py_DECREF(torch);
  Py_XDECREF(nn);
  if (!parameter) {
    Py_XDECREF(tensor);
    return -1;
  }
  st->tensor_type = (PyTypeObject *)tensor;
  st->param_type = (PyTypeObject *)parameter;

  if (intj_intern_names() != 0)
    return -1;
{% if torch_access_mode == 'interpreter' %}
  /* The one layout bet this mode makes, and the only one that can check itself. */
  {
    PyObject *t = PyImport_ImportModule("torch");
    if (!t)
      return -1;
    int rc = intj_dtype_selfcheck(t);
    Py_DECREF(t);
    if (rc != 0)
      return -1;
  }
{% endif %}

{% if not no_gpu %}
  void *gpu = intj_dlopen("{{ driver_path }}");
  if (!gpu)
    return -1;
  st->launch = (intj_launch_t)intj_dlsym(gpu, "{{ launch_symbol }}");
  if (!st->launch)
    return -1;
{% if fixed_device %}
  st->device_get = (intj_device_get_t)intj_dlsym(gpu, "{{ device_symbol }}");
  if (!st->device_get)
    return -1;
{% endif %}
{% if error_style == 'return' %}
  st->error_string = (intj_error_string_ret_t)dlsym(gpu, "{{ error_symbol }}");
{% else %}
  st->error_string = (intj_error_string_out_t)dlsym(gpu, "{{ error_symbol }}");
{% endif %}
{% endif %}
  return 0;
}

static int intj_traverse(PyObject *m, visitproc visit, void *arg) {
  intj_state *st = (intj_state *)PyModule_GetState(m);
  Py_VISIT(st->tensor_type);
  Py_VISIT(st->param_type);
  return 0;
}

static int intj_clear(PyObject *m) {
  intj_state *st = (intj_state *)PyModule_GetState(m);
  Py_CLEAR(st->tensor_type);
  Py_CLEAR(st->param_type);
  return 0;
}

static PyMethodDef intj_methods[] = {
    {"init_bound", (PyCFunction)(void (*)(void))init_bound, METH_FASTCALL, NULL},
    {"header_size", header_size, METH_NOARGS, NULL},
    {"spec_key", (PyCFunction)(void (*)(void))spec_key, METH_FASTCALL, NULL},
{% if tuned %}
    {"key_chain", (PyCFunction)(void (*)(void))key_chain, METH_FASTCALL, NULL},
{% endif %}
    {"set_torch_version", (PyCFunction)(void (*)(void))set_torch_version,
     METH_FASTCALL, NULL},
    {NULL, NULL, 0, NULL}};

static PyModuleDef_Slot intj_slots[] = {
    {Py_mod_exec, (void *)intj_exec},
#ifdef Py_mod_multiple_interpreters /* 3.12+; older CPython has no such slot */
    {Py_mod_multiple_interpreters, Py_MOD_MULTIPLE_INTERPRETERS_NOT_SUPPORTED},
#endif
#ifdef Py_mod_gil /* 3.13+: a free-threaded build keeps the GIL off for it */
    {Py_mod_gil, Py_MOD_GIL_NOT_USED},
#endif
    {0, NULL}};

static struct PyModuleDef intj_module = {
    PyModuleDef_HEAD_INIT, "{{ module_name }}", NULL, sizeof(intj_state),
    intj_methods,          intj_slots,          intj_traverse, intj_clear,
    NULL};

PyMODINIT_FUNC PyInit_{{ module_name }}(void) {
  return PyModuleDef_Init(&intj_module);
}
